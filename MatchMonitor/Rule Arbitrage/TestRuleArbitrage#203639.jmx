<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Test Plan">
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="ProjectFolder" elementType="Argument">
            <stringProp name="Argument.name">ProjectFolder</stringProp>
            <stringProp name="Argument.value">D:/CTS_LoadTest/Module/MatchMonitor</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath">D:\CTS_LoadTest\DBDriver\mysql-connector-j-8.3.0.jar,D:\CTS_LoadTest\DBDriver\mssql-jdbc-12.6.1.jre8.jar</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
    </TestPlan>
    <hashTree>
      <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="[Var Config] Common">
        <collectionProp name="Arguments.arguments">
          <elementProp name="RowNum" elementType="Argument">
            <stringProp name="Argument.name">RowNum</stringProp>
            <stringProp name="Argument.value">200</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="LoopNum" elementType="Argument">
            <stringProp name="Argument.name">LoopNum</stringProp>
            <stringProp name="Argument.value">100</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="ParamValue" elementType="Argument">
            <stringProp name="Argument.name">ParamValue</stringProp>
            <stringProp name="Argument.value">0</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="BatchSizeValue" elementType="Argument">
            <stringProp name="Argument.name">BatchSizeValue</stringProp>
            <stringProp name="Argument.value">100</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="CurrentDateTime" elementType="Argument">
            <stringProp name="Argument.name">CurrentDateTime</stringProp>
            <stringProp name="Argument.value">${__groovy(new Date().format(&quot;yyyy-MM-dd HH:mm:ss&quot;),)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="MySQL_Conn_Local" elementType="Argument">
            <stringProp name="Argument.value">jdbc:mysql://10.18.200.70:3307</stringProp>
            <stringProp name="Argument.name">MySQL_Conn_Local</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="MySQL_DB_CTS_DataCenter" elementType="Argument">
            <stringProp name="Argument.value">CTS_DataCenter</stringProp>
            <stringProp name="Argument.name">MySQL_DB_CTS_DataCenter</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="CustListPath" elementType="Argument">
            <stringProp name="Argument.name">CustListPath</stringProp>
            <stringProp name="Argument.value">${ProjectFolder}/CustList.txt</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="NewTransInfoPath" elementType="Argument">
            <stringProp name="Argument.name">NewTransInfoPath</stringProp>
            <stringProp name="Argument.value">${ProjectFolder}/NewTransInfo_RuleARB.csv</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="ExistingAssInfoPath" elementType="Argument">
            <stringProp name="Argument.name">ExistingAssInfoPath</stringProp>
            <stringProp name="Argument.value">${ProjectFolder}/ExistingAssInfo_RuleARB.csv</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </Arguments>
      <hashTree/>
      <JDBCDataSource guiclass="TestBeanGUI" testclass="JDBCDataSource" testname="[DB Config] CTS_DataCenter" enabled="true">
        <boolProp name="autocommit">true</boolProp>
        <stringProp name="checkQuery">Select 1</stringProp>
        <stringProp name="connectionAge">60000</stringProp>
        <stringProp name="connectionProperties"></stringProp>
        <stringProp name="dataSource">${MySQL_DB_CTS_DataCenter}</stringProp>
        <stringProp name="dbUrl">${MySQL_Conn_Local}/${MySQL_DB_CTS_DataCenter}</stringProp>
        <stringProp name="driver">com.mysql.jdbc.Driver</stringProp>
        <stringProp name="initQuery"></stringProp>
        <boolProp name="keepAlive">true</boolProp>
        <stringProp name="password">123456</stringProp>
        <stringProp name="poolMax">10</stringProp>
        <boolProp name="preinit">false</boolProp>
        <stringProp name="timeout">100000</stringProp>
        <stringProp name="transactionIsolation">DEFAULT</stringProp>
        <stringProp name="trimInterval">600000</stringProp>
        <stringProp name="username">irena.vn</stringProp>
      </JDBCDataSource>
      <hashTree/>
      <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Get CustID list" enabled="true">
        <stringProp name="scriptLanguage">groovy</stringProp>
        <stringProp name="parameters">CustIDList</stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="script">String readFileToString(String filePath) {
    String content = &apos;&apos;
    try {
        content = new File(filePath).text
    } catch (Exception e) {
        log.error(&quot;Error reading file: ${e.message}&quot;)
    }
    return content
}

def filePath = &apos;${CustListPath}&apos;
def CustList = readFileToString(filePath)
vars.put(&quot;CustList&quot;, CustList)</stringProp>
      </JSR223PreProcessor>
      <hashTree/>
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="[1. Reset data]">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <longProp name="ThreadGroup.duration">60</longProp>
        <longProp name="ThreadGroup.delay">0</longProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">false</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </SetupThreadGroup>
      <hashTree>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Update Sys Param" enabled="true">
          <stringProp name="dataSource">${MySQL_DB_CTS_DataCenter}</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query"> update SystemParameter set ParameterValue = ${ParamValue} where ParameterID IN (128);</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Update Sys BatchSize" enabled="true">
          <stringProp name="dataSource">${MySQL_DB_CTS_DataCenter}</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query"> update SystemParameter set ParameterValue = ${BatchSizeValue} where ParameterID IN (129);</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Clean tbl: MatchMonitor" enabled="true">
          <stringProp name="dataSource">${MySQL_DB_CTS_DataCenter}</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">delete from MatchMonitor where MatchID IN (2289511, 2289521, 2289531, 2289512, 2289522, 2289532)  and Reason = 2;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Clean tbl: MatchMonitorDetails" enabled="true">
          <stringProp name="dataSource">${MySQL_DB_CTS_DataCenter}</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">delete from MatchMonitorDetails where MatchID IN (2289511, 2289521, 2289531, 2289512, 2289522, 2289532) and Reason = 2;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Clean tbl: MatchMonitorStagingArbitrageNonLive" enabled="true">
          <stringProp name="dataSource">${MySQL_DB_CTS_DataCenter}</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query"> delete from MatchMonitorStagingArbitrageNonLive where MatchID IN (2289511, 2289521, 2289531, 2289512, 2289522, 2289532);</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Clean tbl: AssociationByDevice" enabled="true">
          <stringProp name="dataSource">${MySQL_DB_CTS_DataCenter}</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">delete d
from AssociationByDevice AS d
	inner join CTSCustomer AS c on c.CTSCustID = d.CTSCustID
where c.CustID IN (${CustList});</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Clean tbl: AssociationByAI" enabled="true">
          <stringProp name="dataSource">${MySQL_DB_CTS_DataCenter}</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">delete from AssociationByAI where FromCustID IN (${CustList}) OR ToCustID IN (${CustList});</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Clean tbl: AssociationGroupByAI" enabled="true">
          <stringProp name="dataSource">${MySQL_DB_CTS_DataCenter}</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">delete from AssociationGroupByAI where CustID IN (${CustList});</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Clean tbl: AssociationByIP" enabled="true">
          <stringProp name="dataSource">${MySQL_DB_CTS_DataCenter}</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">delete from AssociationByIP where FromCustID IN (${CustList}) OR ToCustID IN (${CustList});</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="[2. Prepare existing association]">
        <stringProp name="TestPlan.comments">Duration: 4 hours</stringProp>
        <stringProp name="ThreadGroup.num_threads">${RowNum}</stringProp>
        <longProp name="ThreadGroup.duration">300</longProp>
        <longProp name="ThreadGroup.delay">0</longProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">false</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <intProp name="LoopController.loops">-1</intProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="Get Existing Ass Info">
          <stringProp name="filename">${ExistingAssInfoPath}</stringProp>
          <stringProp name="fileEncoding">utf-8</stringProp>
          <stringProp name="variableNames">CustID,RelatedID,TypeID</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <stringProp name="delimiter">,</stringProp>
          <boolProp name="quotedData">false</boolProp>
          <boolProp name="recycle">false</boolProp>
          <boolProp name="stopThread">true</boolProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
        </CSVDataSet>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl: AssociationByDevice" enabled="true">
          <stringProp name="dataSource">${MySQL_DB_CTS_DataCenter}</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">INSERT IGNORE INTO AssociationByDevice(CTSCustID,DCSDeviceID,SubscriberID,CreatedTime,InsertTime)
SELECT c.CTSCustID,${RelatedID},c.SubscriberID,&apos;${CurrentDateTime}&apos;,&apos;${CurrentDateTime}&apos;
FROM CTSCustomer AS c
where c.CustID = ${CustID} and ${TypeID} IN (11, 12, 13, 41, 42, 43);</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl: AssociationByAI">
          <stringProp name="dataSource">${MySQL_DB_CTS_DataCenter}</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">INSERT IGNORE INTO AssociationByAI(AssType,FromCustID,ToCustID,CreatedDate)
SELECT 1,${CustID},${RelatedID},&apos;${CurrentDateTime}&apos;
FROM CTSCustomer AS c
where c.CustID = ${CustID} and ${TypeID} IN (21, 22, 23);</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl: AssociationByIP">
          <stringProp name="dataSource">${MySQL_DB_CTS_DataCenter}</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">INSERT IGNORE INTO AssociationByIP(AssType,FromCustID,ToCustID,CreatedDate)
SELECT 1,${CustID},${RelatedID},&apos;${CurrentDateTime}&apos;
FROM CTSCustomer AS c
where c.CustID = ${CustID} and ${TypeID} IN (31, 32, 33);</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="[3. Prepare new trans]" enabled="true">
        <stringProp name="TestPlan.comments">Duration: 4 hours</stringProp>
        <stringProp name="ThreadGroup.num_threads">${RowNum}</stringProp>
        <longProp name="ThreadGroup.duration">600</longProp>
        <longProp name="ThreadGroup.delay">0</longProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">false</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <intProp name="LoopController.loops">-1</intProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="Get New Trans Info">
          <stringProp name="filename">${NewTransInfoPath}</stringProp>
          <stringProp name="fileEncoding">utf-8</stringProp>
          <stringProp name="variableNames">SequenceID,MatchID,SportType,IsMajorLeague,BettypeID,BetID,BetTeam,HDP1,HDP2,HDP,StakeRM,TransID,TransDate,CustID </stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <stringProp name="delimiter">,</stringProp>
          <boolProp name="quotedData">false</boolProp>
          <boolProp name="recycle">false</boolProp>
          <boolProp name="stopThread">true</boolProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
        </CSVDataSet>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl: MatchMonitorStagingArbitrageNonLive (Major League)">
          <stringProp name="dataSource">${MySQL_DB_CTS_DataCenter}</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">INSERT IGNORE INTO MatchMonitorStagingArbitrageNonLive(
SequenceID,SportType,BettypeID,BetID,Betteam,Stake,TransID,TransDate,CustID,MatchID,HomeID,AwayID,LeagueID,EventDate,EventStatus,KickOffTime,LeagueName,IsMajorLeague,LiveHomeScore,LiveAwayScore,ScoreDiff,Hdp1,Hdp2,HDP,CTSCustID,SubscriberID,TransDateToSecond,InsertTime,GroupID)
SELECT ${SequenceID},${SportType},${BettypeID},${BetID},&apos;${BetTeam}&apos;,${StakeRM},${TransID},&apos;${TransDate}&apos;,${CustID},${MatchID},111,222,333,&apos;${CurrentDateTime}&apos;,&apos;running&apos;,&apos;${CurrentDateTime}&apos;,&apos;Test Arbitrage Major League&apos;,${IsMajorLeague},0,0,0,&apos;${Hdp1}&apos;,&apos;${Hdp2}&apos;,&apos;${HDP}&apos;,c.CTSCustID,c.SubscriberID,UNIX_TIMESTAMP(&apos;${TransDate}&apos;),&apos;${CurrentDateTime}&apos;,0
FROM CTSCustomer AS c
where c.CustID = ${CustID} AND ${IsMajorLeague} = 1 /*and ${MatchID} = 2289511
and ${SequenceID} IN (23,24,30,31,33,34,70,71,77,78,83,84) and ${CustID} IN (98419065,98419068 ) /*and ${SequenceID} between 20 and 35  and ${CustID} in (1314,891930) */
;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl: MatchMonitorStagingArbitrageNonLive (Minor League)">
          <stringProp name="dataSource">${MySQL_DB_CTS_DataCenter}</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">INSERT IGNORE INTO MatchMonitorStagingArbitrageNonLive(
SequenceID,SportType,BettypeID,BetID,Betteam,Stake,TransID,TransDate,CustID,MatchID,HomeID,AwayID,LeagueID,EventDate,EventStatus,KickOffTime,LeagueName,IsMajorLeague,LiveHomeScore,LiveAwayScore,ScoreDiff,Hdp1,Hdp2,HDP,CTSCustID,SubscriberID,TransDateToSecond,InsertTime,GroupID)
SELECT ${SequenceID},${SportType},${BettypeID},${BetID},&apos;${BetTeam}&apos;,${StakeRM},${TransID},&apos;${TransDate}&apos;,${CustID},${MatchID},111,222,333,&apos;${CurrentDateTime}&apos;,&apos;running&apos;,&apos;${CurrentDateTime}&apos;,&apos;Test Arbitrage Minor League&apos;,${IsMajorLeague},0,0,0,&apos;${Hdp1}&apos;,&apos;${Hdp2}&apos;,&apos;${HDP}&apos;,c.CTSCustID,c.SubscriberID,UNIX_TIMESTAMP(&apos;${TransDate}&apos;),&apos;${CurrentDateTime}&apos;,0
FROM CTSCustomer AS c
where c.CustID = ${CustID} AND ${IsMajorLeague} = 0 /*and ${SequenceID} IN (237,238,239,246,247,248,249,250,251,252)*/
;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
      </hashTree>
      <ResultCollector guiclass="ViewResultsFullVisualizer" testclass="ResultCollector" testname="Tree Result">
        <boolProp name="ResultCollector.error_logging">false</boolProp>
        <objProp>
          <name>saveConfig</name>
          <value class="SampleSaveConfiguration">
            <time>true</time>
            <latency>true</latency>
            <timestamp>true</timestamp>
            <success>true</success>
            <label>true</label>
            <code>true</code>
            <message>true</message>
            <threadName>true</threadName>
            <dataType>true</dataType>
            <encoding>false</encoding>
            <assertions>true</assertions>
            <subresults>true</subresults>
            <responseData>false</responseData>
            <samplerData>false</samplerData>
            <xml>false</xml>
            <fieldNames>true</fieldNames>
            <responseHeaders>false</responseHeaders>
            <requestHeaders>false</requestHeaders>
            <responseDataOnError>false</responseDataOnError>
            <saveAssertionResultsFailureMessage>true</saveAssertionResultsFailureMessage>
            <assertionsResultsToSave>0</assertionsResultsToSave>
            <bytes>true</bytes>
            <sentBytes>true</sentBytes>
            <url>true</url>
            <threadCounts>true</threadCounts>
            <idleTime>true</idleTime>
            <connectTime>true</connectTime>
          </value>
        </objProp>
        <stringProp name="filename">${ProjectFolder}/Report.rpt</stringProp>
      </ResultCollector>
      <hashTree/>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
