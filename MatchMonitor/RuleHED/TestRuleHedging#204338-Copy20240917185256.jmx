          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">INSERT IGNORE INTO AssociationByAI(AssType,FromCustID,ToCustID,CreatedDate)
SELECT 1,${CustID},${RelatedID},&apos;${CurrentDateTime}&apos;
FROM CTSCustomer AS c
where c.CustID = ${CustID} and ${TypeID} IN (21, 22, 23);</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
