        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert Hedging category" enabled="true">
          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert into CTSCustomerClassification_Original (CustID,CTSCustID,SubscriberID,SportGroupID,CategoryID,CreatedDate,CreatedBy,LastScannedDate) 
SELECT c.CustID,c.CTSCustID,c.SubscriberID,0,53,&apos;${CurrentDateTime}&apos;,8,&apos;${CurrentDateTime}&apos;
FROM CTSCustomer AS c 
where c.CustID IN (
/*Flagged*/
1275,1280,1282,5941,96915032,1284,5949,1301,1304,1305,5952,92856881,1306,1308,1309,11576,95238743,1320,1322,1323,67065,98419071,1325,1330,1331,85649,98419077,1332,1336,1337,121124,98419084,1338,129544,1347,1350,1352,166628,98419092,1353,1356,1357,183604,98419098,1366,1369,1371,233772,98419116,1372,1374,1375,272666,98419121,1377,1379,1380,293114,98419128,1382,374909,1390,1392,1393,522112,98419134,1394,1397,1398,609367,98419140,1409,1414,1415,954103,98419160,1419,1421,1424,1111694,98419165,1425,1325700,1432,1435,1436,1336006,98419171,1437,1439,1440,1776777,98419177,1450,1452,1454,2135880,98419200,
/*Affected*/
