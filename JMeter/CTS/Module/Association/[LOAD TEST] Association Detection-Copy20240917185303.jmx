          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import org.apache.http.client.methods.HttpPost
import org.apache.http.entity.StringEntity
import org.apache.http.impl.client.HttpClients
import org.apache.http.HttpResponse
import org.apache.http.util.EntityUtils

def httpClient = HttpClients.createDefault()
String url = &quot;https://${DomainWeb}/v1/UserLogin/Login&quot;
def httpPost = new HttpPost(url)
httpPost.setHeader(&quot;Cookie&quot;, &quot;${cookie}&quot;)
httpPost.setHeader(&quot;Content-Type&quot;, &quot;application/json&quot;)
String jsonBody = &apos;{&quot;username&quot;: &quot;${username}&quot;, &quot;password&quot;: &quot;${hashPw}&quot;, &quot;loginToken&quot;: &quot;${token}&quot;}&apos;
httpPost.setEntity(new StringEntity(jsonBody, &quot;UTF-8&quot;))
HttpResponse response = httpClient.execute(httpPost)
String responseBody = EntityUtils.toString(response.getEntity())

String licensee = &quot;.NAPFORMSAUTH_NAPLICENSEE&quot;
String sessionId = &quot;ASP.NET_SessionId&quot;
var cookie = licensee + &quot;=&quot; + vars.get(&quot;COOKIE_LICENSEE&quot;) + &quot;;&quot; + sessionId + &quot;=&quot; + vars.get(&quot;COOKIE_SESSION_ID&quot;);
vars.put(&quot;cookie&quot;, cookie);

httpClient.close()</stringProp>
