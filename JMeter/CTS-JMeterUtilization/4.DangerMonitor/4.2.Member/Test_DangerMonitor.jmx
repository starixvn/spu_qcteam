        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="Get Match Info" enabled="true">
          <stringProp name="filename">${NewMatchInfoPath}</stringProp>
          <stringProp name="fileEncoding">utf-8</stringProp>
          <stringProp name="variableNames">No,SportType,LeagueID,HomeID,AwayID,Range,ParentNo,ChildType</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <stringProp name="delimiter">,</stringProp>
          <boolProp name="quotedData">false</boolProp>
          <boolProp name="recycle">false</boolProp>
          <boolProp name="stopThread">true</boolProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
        </CSVDataSet>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl: dbo.match ">
          <stringProp name="dataSource">MatchDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert into dbo.match (leagueid,homeid,homeid2,awayid,awayid2,eventstatus,eventdate,kickofftime,GlobalShowTime,creator,matchcode,sporttype,DisplayMode,LeaguePatternID,HomeDisplayPatternID,AwayDisplayPatternID,IsNeutral,HasLive,ParentID,ChildMatchType)
select 	${LeagueID}
	,	${HomeID}
	,	${HomeID}
	,	${AwayID}
	,	${AwayID}
	,	&apos;running&apos;
	,	CASE WHEN ${Range} = 0 THEN &apos;${Tomorrow}&apos;
			WHEN ${Range} = 1 THEN &apos;${Today}&apos; 
			WHEN ${Range} = 2 THEN &apos;${Yesterday}&apos; END
	,	CASE WHEN ${Range} = 0 THEN CAST(&apos;${Tomorrow}&apos; + &apos; 01:00:00&apos; AS DATETIME)
			WHEN ${Range} = 1 THEN CAST(&apos;${Today}&apos; + &apos; 01:00:00&apos; AS DATETIME)
			WHEN ${Range} = 2 THEN CAST(&apos;${Tomorrow}&apos; + &apos; 01:00:00&apos; AS DATETIME) END
	,	CASE WHEN ${Range} = 0 THEN CAST(&apos;${Tomorrow}&apos; + &apos; 01:30:00&apos; AS DATETIME)
			WHEN ${Range} = 1 THEN CAST(&apos;${Today}&apos; + &apos; 01:30:00&apos; AS DATETIME)
			WHEN ${Range} = 2 THEN CAST(&apos;${Yesterday}&apos; + &apos; 01:30:00&apos; AS DATETIME) END
	,	${CreatedBy}
	,	CONCAT(&apos;${MatchCode}&apos;, &apos; &apos;, &apos;${No}&apos;) 
	,	${SportType}
	,	1
	,	1
	,	1
	,	1
	,	0
	,	1
	,    CASE WHEN ${ParentNo} &lt;&gt; 0 THEN ${ParentNo} ELSE NULL END /*Table Tennis: Child match*/
     ,	CASE WHEN ${ParentNo} &lt;&gt; 0 THEN ${ChildType} ELSE NULL END /*Table Tennis: Child match*/
-- WHERE ${No} IN (101, 102, 201, 202, 203, 204, 301, 302, 303, 304, 305, 306, 401, 402, 501, 502, 503, 504, 601, 602, 603, 604)
;</stringProp>
