        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl: dbo.bettrans" enabled="true">
          <stringProp name="dataSource">TransDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert into dbo.bettrans (winlostdate,transdate,matchid,liveindicator,livehomescore,liveawayscore,statusid,status,bettype,betid,betcheck,betteam,betfrom,oddstype,oddsid,odds,hdp1,hdp2,stake,actualrate,custid,username,recommend,mrecommend,srecommend,currency,currencyName,ip,refno,creator) 
select	CAST(&apos;${DayFormat_TblTen}&apos; AS VARCHAR) + &apos; &apos; + FORMAT(${HH}, &apos;00&apos;) + &apos;:&apos; + FORMAT(${MM}, &apos;00&apos;) + &apos;:&apos; + FORMAT(${SS}, &apos;00&apos;) + &apos;.&apos; + FORMAT(${FFF}, &apos;000&apos;),
		CAST(&apos;${DayFormat_TblTen}&apos; AS VARCHAR) + &apos; &apos; + FORMAT(${HH}, &apos;00&apos;) + &apos;:&apos; + FORMAT(${MM}, &apos;00&apos;) + &apos;:&apos; + FORMAT(${SS}, &apos;00&apos;) + &apos;.&apos; + FORMAT(${FFF}, &apos;000&apos;),
		m.MatchID,
		${LiveIndicator},
		${LiveHomeScore},
		${LiveAwayScore},
		${StatusID},
		&apos;${Status}&apos;,
		${BetTypeID},
		${BetID},
		&apos;${BetCheck}&apos;,
		&apos;${BetTeam}&apos;,
		&apos;${BetFrom}&apos;,
		2,/*DEC*/
		&apos;${OddsId}&apos;,
		&apos;${Odds}&apos;,
		&apos;${Hdp1}&apos;,
		&apos;${Hdp2}&apos;,
		${StakeRM},
		1, -- ex.actualrate,
		${CustID},
		cus.username,
		cus.recommend,
		cus.mrecommend,
		cus.srecommend,
		cus.currency,
		ex.currency,
		null,
		${RefNo},
		${CreatedBy}
from dbo.match m with(nolock) cross join 
     (CustDB.dbo.customer cus with(nolock)
	inner join CustDB.dbo.Exchange ex with(nolock) on ex.ExchangeId = cus.currency)
where m.MatchCode like &apos;${MatchCode}%&apos; and RIGHT(m.MatchCode, 3) = &apos;${MatchNo}&apos;
	and cus.CustID = ${CustID}
;</stringProp>
