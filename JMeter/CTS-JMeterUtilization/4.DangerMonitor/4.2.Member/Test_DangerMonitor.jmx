        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl: AssociationByDevice" enabled="false">
          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert into AssociationByDevice(CTSCustID,DCSDeviceID,SubscriberID,CreatedTime,InsertTime) 
select CTSCustID,2208001,SubscriberID,current_timestamp(),current_timestamp() 
from CTSCustomer 
where CustID IN (1327,915832,1332,916740,1337,925314,1339,926213,1346,927837,1308,876080);</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
