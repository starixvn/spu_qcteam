          <stringProp name="shareMode">shareMode.all</stringProp>
          <boolProp name="stopThread">true</boolProp>
          <stringProp name="variableNames">CustId,RoleId,CurrentCategoryId,CategoryId,TurnoverRM,WinlossRM,BetCount,FirstBetDate,LastXDaysTurnoverRM,LastXDaysWinlossRM,LastXDaysBetCount,LastYDaysTurnoverRM,LastYDaysWinlossRM,LastYDaysBetCount,LastXYDaysWinlossRatio,Performanced</stringProp>
        </CSVDataSet>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl: CustomerClassificationAgency">
          <stringProp name="dataSource">VR2ModelDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">INSERT INTO dbo.CustomerClassificationAgency(CustId, RoleId, CurrentCategoryId, CategoryId, TurnoverRM, WinlossRM, BetCount, FirstBetDate, LastXDaysTurnoverRM, LastXDaysWinlossRM, LastXDaysBetCount, LastYDaysTurnoverRM, LastYDaysWinlossRM, LastYDaysBetCount, LastXYDaysWinlossRatio, PerformanceTime, CreatedDate, CreatedTime)
SELECT 	${CustId}
	,	${RoleId}
	,	${CurrentCategoryId}
	,	${CategoryId}
	,	${TurnoverRM}
	,	${WinlossRM}
	,	${BetCount}
	,	${FirstBetDate}
	,	${LastXDaysTurnoverRM}
	,	${LastXDaysWinlossRM}
	,	${LastXDaysBetCount}
	,	${LastYDaysTurnoverRM}
	,	${LastYDaysWinlossRM}
	,	${LastYDaysBetCount}
	,	${LastXYDaysWinlossRatio}
	,	CASE WHEN ${Performanced} = 1 then &apos;${Time1}&apos; 
		WHEN ${Performanced} = 2 then &apos;${Time2}&apos; 
		WHEN ${Performanced} = 3 then &apos;${Time3}&apos; 
		WHEN ${Performanced} = 4 then &apos;${Time4}&apos; end
	,	&apos;${CurrentDateTime}&apos;
	,	&apos;${CurrentDateTime}&apos;
;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
