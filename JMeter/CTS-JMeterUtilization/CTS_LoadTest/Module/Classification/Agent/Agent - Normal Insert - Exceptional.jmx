        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl: CTSCustomerClassificationAgency">
          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">INSERT IGNORE INTO CTSCustomerClassificationAgency (CustID, CTSCustID, SubscriberID, RoleID, ParentID, CategoryID, CreatedDate, CreatedBy, LastModifiedDate, LastModifiedBy, LastScannedDate)
SELECT  ${CustID}
	, c.CTSCustID
	, c.SubscriberID
	, c.RoleID
	, ${ParentID}
	, ${CategoryID}
	, &apos;${Time1}&apos;
	, ${SysID}
	, CASE WHEN ${Modified} = 1 then &apos;${Time1}&apos; 
		WHEN ${Modified} = 2 then &apos;${Time2}&apos; 
		WHEN ${Modified} = 3 then &apos;${Time3}&apos; 
		WHEN ${Modified} = 4 then &apos;${Time4}&apos; end
	, ${SysID}
	, CASE WHEN ${Scanned} = 1 then &apos;${Time1}&apos; 
		WHEN ${Scanned} = 2 then &apos;${Time2}&apos; 
		WHEN ${Scanned} = 3 then &apos;${Time3}&apos; 
		WHEN ${Scanned} = 4 then &apos;${Time4}&apos; end
from CTSCustomer AS c
where c.CustID = ${CustID} and c.CustSubID = 0;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
      </hashTree>
