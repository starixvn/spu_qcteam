      <hashTree>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Get MinSequenceID" enabled="true">
          <stringProp name="dataSource">${SQLServer_DB_bodb02}</stringProp>
          <stringProp name="queryType">Select Statement</stringProp>
          <stringProp name="query">WITH CTE_SequenceID (sequenceid) AS(
			SELECT TOP 20000 b.sequenceid
			FROM dbo.bettrans AS b WITH(NOLOCK, INDEX=IX_sequenceid)
				INNER JOIN dbo.match AS m WITH(NOLOCK) ON b.matchid = m.matchid
				INNER JOIN dbo.league AS l WITH(NOLOCK) ON m.leagueid = l.leagueid
				INNER JOIN bodb02.dbo.Customer AS c WITH(NOLOCK) ON b.recommend = c.custid
			WHERE    m.eventstatus &lt;&gt; &apos;completed&apos;
				AND b.LiveIndicator = 1
				AND b.Currency NOT IN (20,27,28)
				AND b.BetFrom NOT IN (&apos;p&apos;,&apos;m&apos;,&apos;w&apos;,&apos;0&apos;,&apos;3&apos;,&apos;6&apos;)
				AND b.Username NOT LIKE &apos;%Cashout%&apos;
				AND b.srecommend NOT IN (41430709) 
				AND b.mrecommend NOT IN (27899314,11656504,12146012) 
				AND b.recommend NOT IN (52466,5707545,29270764,134456,27787409,48367475,93558369,16604398)
				AND b.statusID &lt;&gt; 101 -- Reject		
				AND c.site NOT IN (&apos;Nextbet&apos;,&apos;9wickets&apos;,&apos;9wsports&apos;)
				AND l.LeagueGroupID NOT IN (42,74,108,113,122,151) -- SABA leagues
				AND b.bettype IN (1,3,7,8)
				AND ISNULL(b.oddstype,0) &lt;&gt; 0
			ORDER BY b.sequenceid DESC
			) 
SELECT MIN(sequenceid) AS MinSequenceID FROM CTE_SequenceID;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree>
          <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="Extractor MinSequenceID" enabled="true">
            <stringProp name="RegexExtractor.useHeaders">false</stringProp>
            <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
            <stringProp name="RegexExtractor.template">$1$</stringProp>
            <stringProp name="RegexExtractor.match_number">1</stringProp>
            <stringProp name="RegexExtractor.refname">MinSequenceID</stringProp>
            <stringProp name="RegexExtractor.regex">(\d+)</stringProp>
            <stringProp name="Scope.variable">MaxSequenceID</stringProp>
          </RegexExtractor>
          <hashTree/>
          <JDBCPostProcessor guiclass="TestBeanGUI" testclass="JDBCPostProcessor" testname="Update Sys Param" enabled="true">
            <stringProp name="dataSource">${MySQL_DB_CTS_DataCenter}</stringProp>
            <stringProp name="query">update SystemParameter set ParameterValue = ${MinSequenceID} - 1 where ParameterID = 20;</stringProp>
