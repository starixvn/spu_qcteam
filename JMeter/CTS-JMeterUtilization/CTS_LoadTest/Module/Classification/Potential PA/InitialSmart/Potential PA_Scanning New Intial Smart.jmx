SELECT 	${CustID}
	, 	&apos;${CurrentDateTime}&apos;
	,	&apos;${CurrentDateTime}&apos;
	,	&apos;${CurrentDateTime}&apos;
WHERE ${CustID} IN (835062,835064,835067,835068,929205,932020,932263,932266,973261,973962,974312,977392)
;</stringProp>
