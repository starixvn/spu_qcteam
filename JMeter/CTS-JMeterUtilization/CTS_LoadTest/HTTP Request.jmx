      <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor" enabled="false">
        <stringProp name="filename"></stringProp>
        <stringProp name="parameters"></stringProp>
        <boolProp name="resetInterpreter">false</boolProp>
        <stringProp name="script">import java.io.BufferedReader;
import java.io.File;
import java.io.FileReader;
import java.io.IOException;

// Method to read file content
String readFileToString(String filePath) {
    StringBuilder content = new StringBuilder();
    try (BufferedReader br = new BufferedReader(new FileReader(new File(filePath)))) {
        String line;
        while ((line = br.readLine()) != null) {
            content.append(line).append(System.lineSeparator()); // Append line with a new line
        }
    } catch (IOException e) {
        // Log the error message in JMeter log
        log.error(&quot;Error reading file: &quot; + e.getMessage());
    }
    return content.toString();
}

// Get the file path from JMeter variables
String filePath = vars.get(&quot;CustListPath&quot;); // Assuming CustListPath is set in JMeter variables
String custList = readFileToString(filePath);

// Store the content in JMeter variable
vars.put(&quot;CustList&quot;, custList);</stringProp>
      </BeanShellPreProcessor>
      <hashTree/>
      <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
        <stringProp name="scriptLanguage">groovy</stringProp>
        <stringProp name="parameters"></stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="script">String readFileToString(String filePath) {
    String content = &apos;&apos;
    try {
        content = new File(filePath).text
    } catch (Exception e) {
        log.error(&quot;Error reading file: ${e.message}&quot;)
    }
    return content
}

def filePath = &apos;${CustListPath}&apos;
def CustList = readFileToString(filePath)
vars.put(&quot;CustList&quot;, CustList)</stringProp>
      </JSR223PreProcessor>
