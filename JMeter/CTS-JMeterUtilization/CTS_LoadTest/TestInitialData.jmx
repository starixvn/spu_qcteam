        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert data tbl: CTSCustomerClassification_History">
          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">INSERT ignore INTO CTSCustomerClassification_History (CustID,CTSCustID,SportGroupID,CategoryID,TurnoverRM,WinlossRM,BetCount,ActiveDays,LastXDaysMargin,ProbationPeriodWinloss,TargetCC,SourceTypeID,FromCategoryID,ToCategoryID,IsAppliedCC,IsDataChanged,ActionType,IsAuto,LastModifiedDate,LastModifiedBy,InsertDate,TaggingType,TargetDangerLevel1,IsAppliedDangerLevel1,TWGroupBettingRate,TWTicketRejectRate,TWDesktopUsageRate,TWBetCount,RobotCounter,Remark,IsDirect,TVSRequestID,IsFromTVS,IsFromTW,IsFromCTS,IsFromAI,IsFromImperva,IsParlay,SportType,IssueTypeID,PerformanceTime,First5TWGBTicketCount,ParentID_new,CategoryID_new,OldCategoryID_new,DWCategoryID_new,SportGroupID_bk,CategoryID_bk,FromCategoryID_bk,ToCategoryID_bk)
SELECT c.CustID,
	c.CTSCustID,
	${SportGroupID},
	${CategoryID},
	${TurnoverRM},
	${WinlossRM},
	${BetCount},
	${ActiveDays},
	${LastXDaysMargin},
	${ProbationPeriodWinloss},
	${TargetCC},
	${SourceTypeID},
	${FromCategoryID},
	${ToCategoryID},
	${IsAppliedCC},
	${IsDataChanged},
	${ActionType},
	${IsAuto},
	&apos;${LastModifiedDate}&apos;,
	${LastModifiedBy},
	&apos;${InsertDate}&apos;,
	${TaggingType},
	${TargetDangerLevel1},
	${IsAppliedDangerLevel1},
	${TWGroupBettingRate},
	${TWTicketRejectRate},
	${TWDesktopUsageRate},
	${TWBetCount},
	${RobotCounter},
	&apos;${Remark}&apos;,
	${IsDirect},
	${TVSRequestID},
	${IsFromTVS},
	${IsFromTW},
	${IsFromCTS},
	${IsFromAI},
	${IsFromImperva},
	${IsParlay},
	${SportType},
	${IssueTypeID},
	&apos;${PerformanceTime}&apos;,
	null,null,null,null,null,null,null,null,null
from CTSCustomer as c
where c.CustID = ${CustID}
;</stringProp>
