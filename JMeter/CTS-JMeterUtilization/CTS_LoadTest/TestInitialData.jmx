          <stringProp name="query">INSERT ignore INTO ArchiveCustomer_CTSCustomer (CTSCustID,SubscriberID,RoleID,CustSubID,UserName,UserName2,CustID,ArchivedDate,ParentID,CategoryID,InsertTime,IsReactivated,ReactivateDate,ProcessedDate,CategoryID_new,CategoryID_bk)
