        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert data tbl: CTSCustomerClassification" enabled="true">
          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">INSERT ignore INTO CTSCustomerClassification (CustID,CTSCustID,SubscriberID,RoleID,IsAffectToDownline,SportGroupID,CategoryID,Remark,CreatedDate,CreatedBy,LastModifiedDate,LastModifiedBy,LastScannedDate,IsFromTVS,IsFromTW,IsFromCTS,IsDirect,TVSRequestID,IsFromAI,IsFromImperva,IsParlay,SportType,IssueTypeID,ParentID_new,CategoryID_new,CreatedDate_new,SportGroupID_bk,CategoryID_bk,CreatedDate_bk,LastScannedDate_new,LastScannedDate_bk)
SELECT c.CustID,
	c.CTSCustID,
	c.SubscriberID,
	c.RoleID,
	${IsAffectToDownline},
	${SportGroupID},
	${CategoryID},
	&apos;${Remark}&apos;,
	&apos;${CreatedDate}&apos;,
	${CreatedBy},
	&apos;${LastModifiedDate}&apos;,
	${LastModifiedBy},
	&apos;${LastScannedDate}&apos;,
	${IsFromTVS},
	${IsFromTW},
	${IsFromCTS},
	${IsDirect},
	${TVSRequestID},
	${IsFromAI},
	${IsFromImperva},
	${IsParlay},
	${SportType},
	${IssueTypeID},
	${ParentID_new},
	${CategoryID_new},
	&apos;${CreatedDate_new}&apos;,
	${SportGroupID_bk},
	${CategoryID_bk},
	&apos;${CreatedDate_bk}&apos;,
	&apos;${LastScannedDate_new}&apos;,
	&apos;${LastScannedDate_bk}&apos;
from CTSCustomer as c
where c.CustID = ${CustID}
;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
