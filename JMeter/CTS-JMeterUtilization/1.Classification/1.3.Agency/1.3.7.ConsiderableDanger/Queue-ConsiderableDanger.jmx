        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert table: CTSCustomerClassificationAgency" enabled="true">
          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">INSERT IGNORE INTO CTSCustomerClassificationAgency (CustID, CTSCustID, SubscriberID, RoleID, ParentID, CategoryID, CreatedDate, CreatedBy, LastScannedDate) 
SELECT  ${CustID}
	, c.CTSCustID
	, c.SubscriberID
	, c.RoleID
	, ${ParentID}
	, ${CategoryID}
	, &apos;${CurrentDateTime}&apos;
	, ${SystemID}
	, &apos;${CurrentDateTime}&apos;
from CTSCustomer AS c
where c.CustID = ${CustID} and c.CustSubID = 0;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert table: CTSCustomerClassificationAgency_History" enabled="true">
          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">INSERT IGNORE INTO CTSCustomerClassificationAgency_History (CustID, CTSCustID, ParentID, CategoryID, LastModifiedDate, LastModifiedBy, InsertDate, TargetCC, SourceTypeID, IsDataChanged, ActionType, IsAuto, PerformanceTime) 
SELECT  ${CustID}
	, c.CTSCustID
	, ${ParentID}
	, ${CategoryID}
	, &apos;${CurrentDateTime}&apos;
	, ${SystemID}
	, &apos;${CurrentDateTime}&apos;
	, cc.CustomerClass
	, 1
	, 1
	, 0
	, 1
	, &apos;${CurrentDateTime}&apos;
from CTSCustomer as c cross join CustomerCategoryAgency as cc 
where c.CustID = ${CustID} and c.CustSubID = 0 and cc.CategoryID = ${CategoryID};</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert table: CTSCustomerClassification" enabled="true">
          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">INSERT IGNORE INTO CTSCustomerClassification (CustID, CTSCustID, SubscriberID, RoleID, ParentID, CategoryID, CreatedDate, CreatedBy, LastScannedDate) 
SELECT   m.CustID
	, m.CTSCustID
	, m.SubscriberID
	, m.RoleID
	, 40000
	, 40100
	, &apos;${CurrentDateTime}&apos;
	, ${SystemID}
	, &apos;${CurrentDateTime}&apos;
from CTSCustomer AS m
where m.Recommend = ${CustID} and m.RoleID = 1;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert table: CTSCustomerClassification_History" enabled="true">
          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">INSERT IGNORE INTO CTSCustomerClassification_History (CustID, CTSCustID, ParentID, CategoryID, LastModifiedDate, LastModifiedBy, InsertDate, TargetCC, SourceTypeID, IsDataChanged, ActionType, IsAuto, PerformanceTime) 
SELECT   m.CustID
	, m.CTSCustID
	, 40000
	, 40100
	, &apos;${CurrentDateTime}&apos;
	, ${SystemID}
	, &apos;${CurrentDateTime}&apos;
	, 200
	, 1
	, 1
	, 0
	, 1
	, &apos;${CurrentDateTime}&apos;
from CTSCustomer as m
where m.Recommend = ${CustID} and m.RoleID = 1;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
