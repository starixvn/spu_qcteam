        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert table: Customer_ConsiderableDanger">
          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">INSERT IGNORE INTO Customer_ConsiderableDanger (CustID, CTSCustID, TotalMember, TotalPAMember, PAMemberRatio, InsertedTime) 
SELECT   ${CustID}
	, c.CTSCustID
	, 10
	, 6
	, 60.00
	, CURRENT_TIMESTAMP()
from CTSCustomer AS c
where ${RoleID} = 2 and c.CustID = ${CustID} and c.CustSubID = 0 and ${ParentID} = 130000;</stringProp>
