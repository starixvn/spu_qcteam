        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert table: CTSCustomerClassificationAgency" enabled="true">
          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">INSERT IGNORE INTO CTSCustomerClassificationAgency (CustID, CTSCustID, SubscriberID, RoleID, ParentID, CategoryID, CreatedDate, CreatedBy, LastScannedDate, LastModifiedDate, LastModifiedBy, Remark, IsFromCTS, IsMarkedDirectly) 
SELECT  ${CustID}
	, c.CTSCustID
	, c.SubscriberID
	, ${RoleID}
	, ${ParentID}
	, ${CategoryID}
	, CURRENT_TIMESTAMP()
	, ${SystemID}
	, CURRENT_DATE()
	, CURRENT_TIMESTAMP()
	, ${SystemID}
	, CASE WHEN ${ParentID} = 130000 THEN &apos;PARatio:60.00&apos; ELSE NULL END
	, CASE WHEN ${ParentID} IN (101000, 120000, 130000, 20000) THEN 1 ELSE NULL END
	, CASE WHEN ${ParentID} IN (101000, 120000, 130000, 20000) THEN 1 ELSE NULL END
from CTSCustomer AS c
where ${RoleID} = 2 and c.CustID = ${CustID} and c.CustSubID = 0;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert table: CTSCustomerClassificationAgency_History" enabled="true">
          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">INSERT IGNORE INTO CTSCustomerClassificationAgency_History (CustID, RoleID, CTSCustID, ParentID, CategoryID, LastModifiedDate, LastModifiedBy, InsertDate, TargetCC, IsDataChanged, ActionType, IsAuto, DWCategoryID, Remark, SourceTypeID, IsFromCTS, IsMarkedDirectly) 
SELECT  ${CustID}
	, ${RoleID}
	, c.CTSCustID
	, ${ParentID}
	, ${CategoryID}
	, CURRENT_TIMESTAMP()
	, ${SystemID}
	, CURRENT_DATE()
	, cc.CustomerClass
	, 1
	, 0
	, 1
	, ${CategoryID}
	, CASE WHEN ${ParentID} = 130000 THEN &apos;PARatio:60.00&apos; ELSE NULL END
	, CASE WHEN ${ParentID} = 130000 THEN 39 WHEN ${ParentID} IN (120000, 20000) THEN 31 WHEN ${ParentID} = 101000 THEN 13 ELSE 3 END
	, CASE WHEN ${ParentID} IN (101000, 120000, 130000, 20000) THEN 1 ELSE NULL END
	, CASE WHEN ${ParentID} IN (101000, 120000, 130000, 20000) THEN 1 ELSE NULL END
from CTSCustomer as c cross join CustomerCategoryAgency as cc 
where ${RoleID} = 2 and c.CustID = ${CustID} and c.CustSubID = 0 and cc.CategoryID = ${CategoryID};</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert table: CTSCustomerClassification">
          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">INSERT IGNORE INTO CTSCustomerClassification (CustID, CTSCustID, SubscriberID, RoleID, ParentID, CategoryID, CreatedDate, CreatedBy, LastScannedDate, LastModifiedDate, LastModifiedBy, IsFromCTS, IsMarkedDirectly) 
SELECT   ${CustID}
	, m.CTSCustID
	, m.SubscriberID
	, ${RoleID}
	, ${ParentID}
	, ${CategoryID}
	, CURRENT_TIMESTAMP()
	, ${SystemID}
	, CURRENT_DATE()
	, CURRENT_TIMESTAMP()
	, ${SystemID}
	, 1
	, 1
from CTSCustomer AS m
where ${RoleID} = 1 and m.CustID = ${CustID};</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert table: CTSCustomerClassification_History">
          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">INSERT IGNORE INTO CTSCustomerClassification_History (CustID, CTSCustID, ParentID, CategoryID, LastModifiedDate, LastModifiedBy, InsertDate, TargetCC, IsDataChanged, ActionType, IsAuto, DWCategoryID, SourceTypeID, IsFromCTS, IsMarkedDirectly) 
SELECT   ${CustID}
	, m.CTSCustID
	, ${ParentID}
	, ${CategoryID}
	, CURRENT_TIMESTAMP()
	, ${SystemID}
	, CURRENT_DATE()
	, cc.CustomerClass
	, 1
	, 0
	, 1
	, ${CategoryID}
	, 31
	, 1
	, 1
from CTSCustomer as m cross join CustomerCategory as cc 
where ${RoleID} = 1 and m.CustID = ${CustID};</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
