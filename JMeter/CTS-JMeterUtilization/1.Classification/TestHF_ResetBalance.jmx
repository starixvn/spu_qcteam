        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl: CustomerClassification_ResetBalance_History (Old)">
          <stringProp name="dataSource">VR2Model</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert into dbo.CustomerClassification_ResetBalance_History (CustID, ResetDate, CreatedTime)
select ${CustID}, &apos;2024-08-08&apos;, &apos;2024-08-08&apos;
where not exists (select 1 from dbo.CustomerClassification_ResetBalance_History where CustID = ${CustID} and ResetDate = &apos;2024-08-08&apos;);</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl: CustomerClassification_ResetBalance_History">
          <stringProp name="dataSource">VR2Model</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert into dbo.CustomerClassification_ResetBalance_History (CustID, ResetDate, CreatedTime)
select ${CustID}, CAST(GETDATE() AS DATE), &apos;${CurrentDateTime}&apos;
where not exists (select 1 from dbo.CustomerClassification_ResetBalance_History where CustID = ${CustID} and ResetDate = CAST(GETDATE() AS DATE));</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl: CustomerClassification_LatestActiveDay">
          <stringProp name="dataSource">VR2Model</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert into dbo.CustomerClassification_LatestActiveDay (CustID, LastTransDate, LastTransTime, CreatedTime)
select ${CustID}, CAST(GETDATE() AS DATE), &apos;${CurrentDateTime}&apos;, &apos;${CurrentDateTime}&apos;
where ${CustID} IN (${ActiveCustIDList}) 
and not exists (select 1 from dbo.CustomerClassification_LatestActiveDay where CustID = ${CustID});</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
