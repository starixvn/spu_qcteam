        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl: CTSCustomerClassification">
          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert ignore into CTSCustomerClassification (CTSCustID, CustID, ParentID, CategoryID, CreatedDate, LastScannedDate, CreatedBy, IsFromCTS, IsMarkedDirectly, IsFromAI, IsFromTW)
select CTSCustID, CustID, ${ParentID}, ${CategoryID}, &apos;${CurrentDateTime}&apos;, current_date(), ${UserID}
	, CASE WHEN ${CategoryID} IN (20400, 21100, 25100) THEN 1 ELSE NULL END
	, CASE WHEN ${CategoryID} IN (20400, 21100, 25100) THEN 1 ELSE NULL END
	, CASE WHEN ${CategoryID} IN (30100, 26200) THEN 1 ELSE NULL END
	, CASE WHEN ${CategoryID} IN (35200) THEN 1 ELSE NULL END
from CTSCustomer
where CustID = ${CustID};</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl: CTSCustomerClassification_History">
          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert ignore into CTSCustomerClassification_History (CTSCustID, CustID, ParentID, CategoryID, LastModifiedDate, InsertDate, LastModifiedBy, IsDataChanged, TargetCC, ActionType, PerformanceTime, OldCategoryID, DWCategoryID, IsFromCTS, IsMarkedDirectly, IsFromAI, IsFromTW, SourceTypeID)
select CTSCustID, CustID, ${ParentID}, ${CategoryID}, &apos;${CurrentDateTime}&apos;, current_date(), ${UserID},  1, ${CustomerClass}, 0, &apos;${CurrentDateTime}&apos;, NULL, ${CategoryID}
	, CASE WHEN ${CategoryID} IN (20400, 21100, 25100) THEN 1 ELSE NULL END
	, CASE WHEN ${CategoryID} IN (20400, 21100, 25100) THEN 1 ELSE NULL END
	, CASE WHEN ${CategoryID} IN (30100, 26200) THEN 1 ELSE NULL END
	, CASE WHEN ${CategoryID} IN (35200) THEN 1 ELSE NULL END
	, CASE WHEN ${CategoryID} IN (20400, 21100, 25100, 26200) THEN 31 
	       WHEN ${CategoryID} IN (30100, 35200) THEN 48 
	       ELSE 3 END
from CTSCustomer
where CustID = ${CustID}
and not exists (select 1 from CTSCustomerClassification_History where CustID = ${CustID} and InsertDate = current_date());</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl: TVSVoidRequest">
          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert ignore into TVSVoidRequest (CustID, CategoryID, TVSReasonID, IssueTypeID, TVSRequestID, RequestTypeID, CreatedDate, InsertedTime, CreatedBy)
select ${CustID}, 20200, 29, 11, 10000, 1, current_date(), &apos;${CurrentDateTime}&apos;, ${UserID}
where ${CustID} IN (1287,1307,1319,1335,1344,1353,1362,1371,1383);</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
