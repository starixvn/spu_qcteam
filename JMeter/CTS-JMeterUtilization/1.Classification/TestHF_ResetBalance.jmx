          <stringProp name="script">1. Normal Category: SP CTS_GeneralNormalClassification_NormalPool_Classify
--INSERT INTO #tmpRawData(CustId, SportGroup, TurnoverRM, WinlossRM, TurnoverORG, WinlossORG, BetCount, ActiveDaysCustID, ActiveDaysSportGroup, WindaysCustID, WinDaysSportGroup, ProcessedTime)
	--EXEC bodb_dwrs.dbo.Acc_Rpt_CTS_GetCustAccumulatedInfo @ListCustID = @ListCustIds, @isResetBalance = 1;

	/*NA TEST*/
	INSERT INTO #tmpRawData(CustId, SportGroup, TurnoverRM, WinlossRM, TurnoverORG, WinlossORG, BetCount, ActiveDaysCustID, ActiveDaysSportGroup, WindaysCustID, WinDaysSportGroup, ProcessedTime) values
	--new
	(1275, 1, 5000, -4999, 0, 0, 9, 5, 5, 5, 5, GETDATE())
	,(1306, 1, 5000, -4999, 0, 0, 9, 5, 5, 5, 5, GETDATE()) 
	,(1314, 1, 5000, -4999, 0, 0, 9, 5, 5, 5, 5, GETDATE()) 
	-- normal
	,(1280, 1, 5000, 9999, 0, 0, 10, 5, 5, 5, 5, GETDATE()) 
	,(1282, 1, 5000, 9999, 0, 0, 10, 5, 5, 5, 5, GETDATE()) -- inactive
	,(1302, 1, 5000, 9999, 0, 0, 10, 5, 5, 5, 5, GETDATE()) -- inactive
	,(1313, 1, 5000, 9999, 0, 0, 10, 5, 5, 5, 5, GETDATE()) -- inactive
	-- prob
	,(1305, 1, 15001, 15001, 0, 0, 20, 5, 5, 5, 5, GETDATE()) -- inactive
	,(1312, 1, 15001, 15001, 0, 0, 20, 5, 5, 5, 5, GETDATE()) -- inactive
	; 

2. Problem Category: SP CTS_ProblemAccountsClassification_Daily
   /*NA TEST*/
DELETE a WITH (ROWLOCK)   FROM #tmpCustomerAccummulatedInfo AS a  where a.custid in (1275,1277,791050,  53847100,99333765);
INSERT INTO #tmpCustomerAccummulatedInfo (CustId, TurnoverRM, WinlossRM, BetCount, ActiveDays)  
 --SELECT CustID,100000, 5000, 50, 10  FROM #tmpCustomers  as a where a.custid in (1275)
 --union all
  --SELECT CustID,100000, -15000, 50, 10  FROM #tmpCustomers  as a where a.custid in (1277, 53847100,99333765)
  --union all
 SELECT CustID,100000, -15000, 50, 10  FROM #tmpCustomers  as a where a.custid in (1331,1344,1345,1348,1352,1360,1362,1363,1364,1367,1383,1384,1386)
 ;

</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
