        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Execute SP: CTS_NormalClassification_RealTime_CheckChanges" enabled="true">
          <stringProp name="dataSource">VR2ModelDB</stringProp>
          <stringProp name="queryType">Callable Statement</stringProp>
          <stringProp name="query">DECLARE	@NextScannedDateTime1 datetime2(7),
		@NextScannedDateTime2 datetime2(7),
		@NextScannedDateTime3 datetime2(7),
		@NextScannedDateTime4 datetime2(7)
EXEC	dbo.CTS_NormalClassification_RealTime_CheckChanges
		@NextScannedDateTime1 = @NextScannedDateTime1 OUTPUT,
		@NextScannedDateTime2 = @NextScannedDateTime2 OUTPUT,
		@NextScannedDateTime3 = @NextScannedDateTime3 OUTPUT,
		@NextScannedDateTime4 = @NextScannedDateTime4 OUTPUT
SELECT	@NextScannedDateTime1 as N&apos;@NextScannedDateTime1&apos;,
		@NextScannedDateTime2 as N&apos;@NextScannedDateTime2&apos;,
		@NextScannedDateTime3 as N&apos;@NextScannedDateTime3&apos;,
		@NextScannedDateTime4 as N&apos;@NextScannedDateTime4&apos;;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Get Output" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonOutput

def responseData = prev.getResponseDataAsString().trim()

// Tách các tập dữ liệu dựa trên khoảng trống hoặc dấu phân cách (dùng dấu tùy theo SP trả về)
def dataSets = responseData.split(/\r?\n\r?\n/) 

if (dataSets.size() &gt;= 3) { // Đảm bảo có đủ 3 tập dữ liệu
    def processDataSet = { dataSet, selectedColumns -&gt;
        def lines = dataSet.split(&quot;\n&quot;).findAll { it.trim() } // Tách dòng và loại bỏ dòng trống
        def headers = lines[0].split(&quot;\t|,&quot;).collect { it.trim() } // Lấy tiêu đề cột
        def rows = lines[1..-1] // Dữ liệu bắt đầu từ dòng thứ 2
        
        rows.collect { line -&gt;
            def values = line.split(&quot;\t|,&quot;).collect { it.trim() }
            headers.collectEntries { header -&gt;
                if (header in selectedColumns) { [(header): values[headers.indexOf(header)] ?: &quot;&quot;] } else null
            }.findAll { it != null } // Loại bỏ các cột không thuộc `selectedColumns`
        }
    }

    def selectedColumnsForSet1 = [&quot;CustId&quot;, &quot;LastTicketDate&quot;] // Chọn các cột mong muốn cho tập 1
    def jsonDataSet1 = JsonOutput.toJson(processDataSet(dataSets[0], selectedColumnsForSet1))

    def selectedColumnsForSet2 = [&quot;CustID&quot;, &quot;LastTicketDate&quot;] // Chọn các cột mong muốn cho tập 2
    def jsonDataSet2 = JsonOutput.toJson(processDataSet(dataSets[1], selectedColumnsForSet2))

    def processDataSet3 = { dataSet -&gt;
         def lines = dataSet.split(&quot;\n&quot;).findAll { it.trim() }
         def headers = lines[0].split(&quot;\t|,&quot;).collect { it.trim() } // Lấy tiêu đề cột
         def row = lines[1] // Các dòng dữ liệu

         // Tách các giá trị trong dòng dữ liệu
         def values = row.split(&quot;\t|,&quot;).collect { it.trim() }
        
         // Lưu giá trị vào các biến JMeter với tên cột cố định
	    headers.eachWithIndex { header, colIdx -&gt;
	        def variableName = header // Tạo tên biến theo cột, ví dụ CustID, RoleID, ...
	        def value = values[colIdx] ?: &quot;&quot; // Nếu không có giá trị thì gán &quot;&quot;
	        vars.put(variableName, value) // Lưu vào biến JMeter
	    }
    }
    processDataSet3(dataSets[2]) // Gọi hàm xử lý tập 3

    // Lưu JSON của tập 1 và 2 vào biến JMeter
    vars.put(&quot;JSONDataSet1&quot;, jsonDataSet1)
    vars.put(&quot;JSONDataSet2&quot;, jsonDataSet2)

    // Log kết quả
    log.info(&quot;JSONDataSet1: &quot; + jsonDataSet1)
    log.info(&quot;JSONDataSet2: &quot; + jsonDataSet2)
    log.info(&quot;NextScanned1: &quot; + vars.get(&quot;@NextScannedDateTime1&quot;))
    log.info(&quot;NextScanned2: &quot; + vars.get(&quot;@NextScannedDateTime2&quot;))
    log.info(&quot;NextScanned3: &quot; + vars.get(&quot;@NextScannedDateTime3&quot;))
    log.info(&quot;NextScanned4: &quot; + vars.get(&quot;@NextScannedDateTime4&quot;))
    
} else {
    log.warn(&quot;Not enough datasets returned&quot;)
    vars.put(&quot;JSONDataSet1&quot;, &quot;[]&quot;)
    vars.put(&quot;JSONDataSet2&quot;, &quot;[]&quot;)
}</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
