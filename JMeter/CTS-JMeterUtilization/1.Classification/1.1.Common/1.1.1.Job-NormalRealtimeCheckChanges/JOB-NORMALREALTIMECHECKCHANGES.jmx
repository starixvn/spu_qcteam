        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert table: CustomerClassification_LatestActiveDay" enabled="true">
          <stringProp name="dataSource">VR2ModelDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert into dbo.CustomerClassification_LatestActiveDay (CustID, LastTransDate, LastTransTime, CreatedTime)
select   cus.CustID, 
         &apos;2024-11-01&apos;, 
         &apos;2024-11-01&apos;, 
         &apos;2024-11-01&apos;
from bodb02.dbo.customer cus with(nolock)
where cus.CustID IN (
791050,791054,832131,832132,832134,832138
); 
</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
          <stringProp name="TestPlan.comments">Existing data --&gt; Update LastTransDate = NewLastTransDate</stringProp>
        </JDBCSampler>
