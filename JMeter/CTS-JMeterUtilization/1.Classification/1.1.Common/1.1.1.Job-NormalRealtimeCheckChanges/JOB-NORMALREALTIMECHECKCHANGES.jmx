          <stringProp name="query">DECLARE	@NextScannedDateTime1 datetime2(7),
		@NextScannedDateTime2 datetime2(7),
		@NextScannedDateTime3 datetime2(7),
		@NextScannedDateTime4 datetime2(7)
EXEC bodb_dwrs.dbo.Acc_Rpt_CTS_GetListCustByModifiedDate 
     @fromModifiedDate_01 = &apos;${StartTimeJob}&apos;
,	@fromModifiedDate_02 = &apos;${StartTimeJob}&apos;
,	@fromModifiedDate_03 = &apos;${StartTimeJob}&apos;
,	@fromModifiedDate_04 = &apos;${StartTimeJob}&apos;
,	@toModifiedDate_01 = &apos;${CurrentDateTime}&apos;
,	@toModifiedDate_02 = &apos;${CurrentDateTime}&apos;
,	@toModifiedDate_03 = &apos;${CurrentDateTime}&apos;
,	@toModifiedDate_04 = &apos;${CurrentDateTime}&apos;
,	@scannedModifiedDate_01 = @NextScannedDateTime1 OUTPUT
,	@scannedModifiedDate_02 = @NextScannedDateTime2 OUTPUT
,	@scannedModifiedDate_03 = @NextScannedDateTime3 OUTPUT
,	@scannedModifiedDate_04 = @NextScannedDateTime4 OUTPUT;</stringProp>
