        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Execute SP: CTS_DC_CustClassification_DailyScan_GetInactiveNewMember">
          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Callable Statement</stringProp>
          <stringProp name="query">set @op_LastCategoryID = &apos;0&apos;;
set @op_LastCustID = &apos;0&apos;;
CALL CTS_DC_CustClassification_DailyScan_GetInactiveNewMember_xpre (@op_LastCategoryID, @op_LastCustID);</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Get Output 1" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonOutput

def responseData = prev.getResponseDataAsString().trim()

// Tách các tập dữ liệu dựa trên khoảng trống hoặc dấu phân cách (dùng dấu tùy theo SP trả về)
def dataSets = responseData.split(/\r?\n\r?\n/) 

if (dataSets.size() &gt;= 1) { // Đảm bảo có đủ 3 tập dữ liệu
    def processDataSet = { dataSet, selectedColumns -&gt;
        def lines = dataSet.split(&quot;\n&quot;).findAll { it.trim() } // Tách dòng và loại bỏ dòng trống
        def headers = lines[0].split(&quot;\t|,&quot;).collect { it.trim() } // Lấy tiêu đề cột
        def rows = lines[1..-1] // Dữ liệu bắt đầu từ dòng thứ 2
        
        rows.collect { line -&gt;
            def values = line.split(&quot;\t|,&quot;).collect { it.trim() }
            headers.collectEntries { header -&gt;
                if (header in selectedColumns) { [(header): values[headers.indexOf(header)] ?: &quot;&quot;] } else null
            }.findAll { it != null } // Loại bỏ các cột không thuộc `selectedColumns`
        }

        def combinedCustIDs = rows.join(&quot;,&quot;)
    }

    def processDataSet2 = { dataSet -&gt;
         def lines = dataSet.split(&quot;\n&quot;).findAll { it.trim() }
         def headers = lines[0].split(&quot;\t|,&quot;).collect { it.trim() } // Lấy tiêu đề cột
         def row = lines[1] // Các dòng dữ liệu

         // Tách các giá trị trong dòng dữ liệu
         def values = row.split(&quot;\t|,&quot;).collect { it.trim() }
        
         // Lưu giá trị vào các biến JMeter với tên cột cố định
	    headers.eachWithIndex { header, colIdx -&gt;
	        def variableName = header // Tạo tên biến theo cột, ví dụ CustID, RoleID, ...
	        def value = values[colIdx] ?: &quot;&quot; // Nếu không có giá trị thì gán &quot;&quot;
	        vars.put(variableName, value) // Lưu vào biến JMeter
	    }
    }
    processDataSet2(dataSets[1]) // Gọi hàm xử lý tập 3

    // Lưu ListCustID của tập 1
    vars.put(&quot;CustIDList1&quot;, combinedCustIDs)

    // Log kết quả
    log.info(&quot;CustIDList1: &quot; + CustIDList1)
    log.info(&quot;LastCategoryID: &quot; + vars.get(&quot;@op_LastCategoryID&quot;))
    log.info(&quot;LastCustID: &quot; + vars.get(&quot;@op_LastCustID&quot;))
    
} else {
    log.warn(&quot;Not enough datasets returned&quot;)
    vars.put(&quot;CustIDList1&quot;, &quot;null&quot;)
    vars.put(&quot;@op_LastCategoryID&quot;, &quot;null&quot;)
    vars.put(&quot;@op_LastCustID&quot;, &quot;null&quot;)
}</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
