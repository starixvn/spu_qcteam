          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert into dbo.CustomerClassification_NormalPool (CustID, Priority, FunctionId, CreatedTime)
select cus.CustID,5,10,&apos;${CurrentDateTime}&apos; from bodb02.dbo.customer cus with(nolock) where cus.CustID IN (${CustIDList}) -- Lic Sub
--select cus.CustID,100,1,&apos;${CurrentDateTime}&apos; from bodb02.dbo.customer cus with(nolock) where cus.CustID IN (${CustIDList}) -- Realtime
--UNION ALL select cus.CustID,300,3,&apos;${CurrentDateTime}&apos; from bodb02.dbo.customer cus with(nolock) where cus.CustID IN (${CustIDList})-- Probation
-- UNION ALL select cus.CustID,300,3,&apos;${CurrentDateTime}&apos; from bodb02.dbo.customer cus with(nolock) where cus.CustID IN (${CustIDList})-- Daily
-- UNION ALL select cus.CustID,10,4,&apos;${CurrentDateTime}&apos; from bodb02.dbo.customer cus with(nolock) where cus.CustID IN (${CustIDList})-- Rescan by Manual
-- UNION ALL select cus.CustID,20,5,&apos;${CurrentDateTime}&apos; from bodb02.dbo.customer cus with(nolock) where cus.CustID IN (${CustIDList})-- Resca New Cust
-- UNION ALL select cus.CustID,30,6,&apos;${CurrentDateTime}&apos; from bodb02.dbo.customer cus with(nolock) where cus.CustID IN (${CustIDList})-- Rescan by Affect
-- UNION ALL select cus.CustID,1000,7,&apos;${CurrentDateTime}&apos; from bodb02.dbo.customer cus with(nolock) where cus.CustID IN (${CustIDList})-- Daily Tagging
-- UNION ALL select cus.CustID,1000,8,&apos;${CurrentDateTime}&apos; from bodb02.dbo.customer cus with(nolock) where cus.CustID IN (${CustIDList})-- New Inactive
-- UNION ALL select cus.CustID,100,9,&apos;${CurrentDateTime}&apos; from bodb02.dbo.customer cus with(nolock) where cus.CustID IN (${CustIDList})-- CC210x
 AND cus.CustID NOT IN (4631294, 4639971, 4917029)
;</stringProp>
