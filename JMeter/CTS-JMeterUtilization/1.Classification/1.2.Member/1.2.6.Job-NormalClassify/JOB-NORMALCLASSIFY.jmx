        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Execute SP: CTS_GeneralNormalClassification_NormalPool_Get" enabled="true">
          <stringProp name="dataSource">VR2ModelDB</stringProp>
          <stringProp name="queryType">Callable Statement</stringProp>
          <stringProp name="query">DECLARE @ScannedMaxId BIGINT;
EXEC dbo.CTS_GeneralNormalClassification_NormalPool_Get_xtest @ScannedMaxId = @ScannedMaxId OUTPUT;
SELECT @ScannedMaxId;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as Object</stringProp>
        </JDBCSampler>
        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Get Output 1" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def responseData = prev.getResponseDataAsString().trim()
def lines = responseData.split(&quot;\n&quot;).findAll { it.trim() } // Tách từng dòng và loại bỏ dòng trống

if (lines.size() &gt; 1) {
     def headers = lines[0].split(&quot;\t|,&quot;).collect { it.trim() }
     def custIDIndex = headers.indexOf(&quot;CustId&quot;) // Xác định vị trí của cột CustID
     
     def custIDList = lines[1..-3].findAll { line -&gt; 
        !line.toLowerCase().contains(&quot;output variables by position:&quot;) // Loại bỏ dòng không hợp lệ
     }.collect { line -&gt; 
       def values = line.split(&quot;\t|,&quot;).collect { it.trim() } // Tách giá trị từng dòng
       values[custIDIndex] // Lấy CustID
     }.findAll { it } // Loại bỏ giá trị null hoặc rỗng

     def scannedMaxID = lines[-2].trim() // Lấy giá trị từ dòng cuối cùng (ScannedMaxID)
	
	def combinedCustIDs = custIDList.join(&quot;,&quot;)
	
	vars.put(&quot;CustIDList1&quot;, combinedCustIDs)
	vars.put(&quot;ScannedMaxID&quot;, scannedMaxID.isNumber() ? scannedMaxID : &quot;&quot;)
	
     log.info(&quot;CustIDList1: &quot; + vars.get(&quot;CustIDList1&quot;))
     log.info(&quot;ScannedMaxID: &quot; + vars.get(&quot;ScannedMaxID&quot;))
} else {
    log.warn(&quot;No data rows available&quot;)
    vars.put(&quot;CustIDList1&quot;, &quot;null&quot;) // Nếu không có dữ liệu, đặt giá trị mặc định
    vars.put(&quot;ScannedMaxID&quot;, &quot;null&quot;)
}</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Execute SP: CTS_DC_CustClassification_Normal_GetCurrentCategory" enabled="true">
          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Callable Statement</stringProp>
          <stringProp name="query">CALL CTS_DC_CustClassification_Normal_GetCurrentCategory_xtest(@ip_CustIDList:=&apos;${CustIDList1}&apos;);</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as Object</stringProp>
        </JDBCSampler>
        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Get Output 2" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def responseData = prev.getResponseDataAsString().trim()
def lines = responseData.split(&quot;\n&quot;).findAll { it.trim() }

if (lines.size() &gt; 1) {
	def validDataLines = lines.drop(1).findAll { line -&gt; // Bỏ dòng đầu tiên (header) và chỉ giữ các dòng dữ liệu hợp lệ
	    def values = line.split(&quot;\t&quot;).collect { it.trim() }
	    values.size() == 4 &amp;&amp; values[0].isInteger() 
	}

	def columnTitles = [&quot;CustId&quot;, &quot;RoleId&quot;, &quot;CategoryId&quot;, &quot;IsNewCreated&quot;, &quot;IsRealtimeOnly&quot;]
	def indexes = columnTitles.collect { columnTitles.indexOf(it) }
	
	def writer = new StringWriter()
	def xml = new groovy.xml.MarkupBuilder(writer)
	xml.setDoubleQuotes(true) // Bắt buộc MarkupBuilder dùng dấu `&quot;`
	
	xml.Root {
	    validDataLines.each { line -&gt;
	        def values = line.split(&quot;\t&quot;).collect { it.trim() }
	
	        r(indexes.collectEntries { index -&gt;
                def value = values[index]?.toLowerCase() == &quot;null&quot; ? &quot;0&quot; : values[index] // Thay &quot;null&quot; thành &quot;0&quot;

                if (columnTitles[index] == &quot;IsRealtimeOnly&quot;) {// Nếu là cột IsRealtimeOnly, gán giá trị là &quot;0&quot;
                    value = &quot;0&quot;
                }
                
                [(columnTitles[index]): value]
            })
	    }
	}
	
	def xmlString = writer.toString()
	vars.put(&quot;XMLDataSet&quot;, xmlString)
	log.info(&quot;Generated XML: &quot; + vars.get(&quot;XMLDataSet&quot;))
	
} else {
    log.warn(&quot;No data rows available&quot;)
    vars.put(&quot;XMLDataSet&quot;, &quot;&lt;Root&gt;&lt;r /&gt;&lt;/Root&gt;&quot;) // Nếu không có dữ liệu, đặt giá trị mặc định
}</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
