        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert table: tbl_Currency_Daily" enabled="true">
          <stringProp name="dataSource">AccountDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert into dbo.tbl_Currency_Daily (Currency,Rate,ExchangeDate,DateUpdated) 
select ExchangeId,1,CAST(DATEADD(DAY,-1,GETDATE()) AS DATE),CAST(DATEADD(DAY,-1,GETDATE()) AS DATE) from bodb02.dbo.Exchange where ExchangeId IN (1,3,5,6,13,22) UNION ALL
select ExchangeId,1,CAST(DATEADD(DAY,-2,GETDATE()) AS DATE),CAST(DATEADD(DAY,-2,GETDATE()) AS DATE) from bodb02.dbo.Exchange where ExchangeId IN (1,3,5,6,13,22) UNION ALL
select ExchangeId,1,CAST(DATEADD(DAY,-3,GETDATE()) AS DATE),CAST(DATEADD(DAY,-3,GETDATE()) AS DATE) from bodb02.dbo.Exchange where ExchangeId IN (1,3,5,6,13,22) UNION ALL
select ExchangeId,1,CAST(DATEADD(DAY,-4,GETDATE()) AS DATE),CAST(DATEADD(DAY,-4,GETDATE()) AS DATE) from bodb02.dbo.Exchange where ExchangeId IN (1,3,5,6,13,22) UNION ALL
select ExchangeId,1,CAST(DATEADD(DAY,-5,GETDATE()) AS DATE),CAST(DATEADD(DAY,-5,GETDATE()) AS DATE) from bodb02.dbo.Exchange where ExchangeId IN (1,3,5,6,13,22) UNION ALL
select ExchangeId,1,CAST(DATEADD(DAY,-30,GETDATE()) AS DATE),CAST(DATEADD(DAY,-30,GETDATE()) AS DATE) from bodb02.dbo.Exchange where ExchangeId IN (1,3,5,6,13,22) UNION ALL
select ExchangeId,1,CAST(DATEADD(DAY,-31,GETDATE()) AS DATE),CAST(DATEADD(DAY,-31,GETDATE()) AS DATE) from bodb02.dbo.Exchange where ExchangeId IN (1,3,5,6,13,22) UNION ALL
select ExchangeId,1,CAST(DATEADD(DAY,-32,GETDATE()) AS DATE),CAST(DATEADD(DAY,-32,GETDATE()) AS DATE) from bodb02.dbo.Exchange where ExchangeId IN (1,3,5,6,13,22) UNION ALL
select ExchangeId,1,CAST(DATEADD(DAY,-33,GETDATE()) AS DATE),CAST(DATEADD(DAY,-33,GETDATE()) AS DATE) from bodb02.dbo.Exchange where ExchangeId IN (1,3,5,6,13,22) UNION ALL
select ExchangeId,1,CAST(DATEADD(DAY,-34,GETDATE()) AS DATE),CAST(DATEADD(DAY,-34,GETDATE()) AS DATE) from bodb02.dbo.Exchange where ExchangeId IN (1,3,5,6,13,22);</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert table: CustomerClassification_LatestActiveDay" enabled="true">
          <stringProp name="dataSource">VR2ModelDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert into dbo.CustomerClassification_LatestActiveDay (CustID, LastTransDate, LastTransTime, CreatedTime)
select cus.CustID,GETDATE(),&apos;${CurrentDateTime}&apos;,&apos;${CurrentDateTime}&apos;
from bodb02.dbo.customer cus with(nolock)
where cus.CustID IN (
4368025,4368028,4504628,4507126,4508285,4511216,4526651,4526779,4629708,4631294,4639971,4640185,4664672,4671649,4795990,4816920,4817040,4831332,4836185,4836532,4842736,4860289,4866007,4866084,4868833,4885249,4901063,4905097,4910066,4911089,4917029,4921038,4926783,4927707,4954836,4957815,4974168,4987017,4991151,5003571,5007868,5007912,5014234,5014478,5029741,5040379,5067726,5074571,5078586,5113919,5121216,5122032,5126520,5126561,5152986,5153631,5156544,5156631,5167627,5169372
