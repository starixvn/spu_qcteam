          <stringProp name="query">INSERT IGNORE INTO CTSCustomerClassification (CustID, CTSCustID, SubscriberID, RoleID, ParentID, CategoryID, CreatedDate, CreatedBy, LastScannedDate, IsFromAI, IsFromTW) 
SELECT  ${CustID}
	, c.CTSCustID
	, c.SubscriberID
	, c.RoleID
	, ${ParentID}
	, ${CategoryID}
	, &apos;${CurrentDateTime}&apos;
	, ${SystemID}
	, &apos;${CurrentDateTime}&apos;
	, CASE WHEN ${IsFromAI} = -1 THEN NULL ELSE ${IsFromAI} END
	, CASE WHEN ${IsFromTW} = -1 THEN NULL ELSE ${IsFromTW} END
from CTSCustomer AS c
where c.CustID = ${CustID} AND c.CustID NOT IN (4631294, 4639971, 4917029)
;</stringProp>
