        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert table: SpecialCustomerClass" enabled="true">
          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert into SpecialCustomerClass (CTSCustID,CustID,RootCTSCustID,SubscriberID,CustomerClass,CreatedBy,CreatedDate,CreatedFromFunction)
select CTSCustID,CustID,CTSCustID,SubscriberID,100,8,current_timestamp(),1
from CTSCustomer
where CustID in (4885249,5113919,5363790,4905097,5152986,5487980,4911089,5169372,5589780) AND CustID NOT IN (4631294, 4639971, 4917029)
;
</stringProp>
          <stringProp name="queryArguments"></stringProp>
