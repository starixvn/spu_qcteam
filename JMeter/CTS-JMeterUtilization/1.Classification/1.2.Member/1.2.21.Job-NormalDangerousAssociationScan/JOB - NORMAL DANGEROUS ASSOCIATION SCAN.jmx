        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="Get Accumulated Performance Info" enabled="true">
          <stringProp name="delimiter">,</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="filename">${AccumulatedPerformanceInfoPath}</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <boolProp name="quotedData">false</boolProp>
          <boolProp name="recycle">false</boolProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
          <boolProp name="stopThread">true</boolProp>
          <stringProp name="variableNames">MatchID,LeagueID,SportType,ProductID,TransID,BetTypeID,Turnover,Winloss,BetCount,Status,StatusID,CustID,TransHour,RptNumDay,SourceID</stringProp>
        </CSVDataSet>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert table: ODS_bettrans_final_SiteDB01_batch01" enabled="true">
          <stringProp name="dataSource">ODSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert into dbo.ODS_bettrans_final_SiteDB01_batch01 (WinlostDate,TransDate,ModifiedDate,MatchID,LeagueID,SportType,ProductID,TransID,BetType,Stake,actual_stake,Winlost,BetCount,ActualRate,Status,ExternalBet,CustID,Currency,Recommend,Mrecommend,Srecommend,SiteID)
select        CAST(DATEADD(DAY, ${RptNumDay}, CAST(GETDATE() AS DATE)) AS VARCHAR) + &apos;${TransHour}&apos;
		, CAST(DATEADD(DAY, ${RptNumDay}, CAST(GETDATE() AS DATE)) AS VARCHAR) + &apos;${TransHour}&apos;
		, CAST(DATEADD(DAY, ${RptNumDay}, CAST(GETDATE() AS DATE)) AS VARCHAR) + &apos;${TransHour}&apos;
		, ${MatchID}
		, ${LeagueID}
		, ${SportType}
		, ${ProductID}
		, ${TransID}
		, ${BetTypeID}	
		, ${Turnover}
		, 0 -- winlostRM = (winlost - actual_stake) * actual_rate
		, ${Winloss}
		, ${BetCount}
		, 1 -- winlostRM = (winlost - actual_stake) * actual_rate
		, &apos;${Status}&apos;
		, 1
		, ${CustID}
		, cus.Currency
		, CASE WHEN cus.Recommend IS NOT NULL THEN cus.Recommend  ELSE 0 END
		, CASE WHEN cus.Mrecommend IS NOT NULL THEN cus.MRecommend  ELSE 0 END
		, CASE WHEN cus.Srecommend IS NOT NULL THEN cus.SRecommend  ELSE 0 END
		, st.SiteID
from bodb02.dbo.customer cus with(nolock)
	inner join bodb02.dbo.Site st with(nolock) on cus.Site = st.Site
where ${SourceID} = 1 and cus.CustID = ${CustID};</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert table: ODS_bettrans_final_SiteDB03_batch01" enabled="true">
          <stringProp name="dataSource">ODSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert into dbo.ODS_bettrans_final_SiteDB03_batch01 (WinlostDate,TransDate,ModifiedDate,MatchID,LeagueID,SportType,ProductID,TransID,BetType,Stake,actual_stake,Winlost,BetCount,ActualRate,Status,ExternalBet,CustID,Currency,Recommend,Mrecommend,Srecommend,SiteID)
select        CAST(DATEADD(DAY, ${RptNumDay}, CAST(GETDATE() AS DATE)) AS VARCHAR) + &apos;${TransHour}&apos;
		, CAST(DATEADD(DAY, ${RptNumDay}, CAST(GETDATE() AS DATE)) AS VARCHAR) + &apos;${TransHour}&apos;
		, CAST(DATEADD(DAY, ${RptNumDay}, CAST(GETDATE() AS DATE)) AS VARCHAR) + &apos;${TransHour}&apos;
		, ${MatchID}
		, ${LeagueID}
		, ${SportType}
		, ${ProductID}
		, ${TransID}
		, ${BetTypeID}	
		, ${Turnover}
		, 0 -- winlostRM = (winlost - actual_stake) * actual_rate
		, ${Winloss}
		, ${BetCount}
		, 1 -- winlostRM = (winlost - actual_stake) * actual_rate
		, &apos;${Status}&apos;
		, 1
		, ${CustID}
		, cus.Currency
		, CASE WHEN cus.Recommend IS NOT NULL THEN cus.Recommend  ELSE 0 END
		, CASE WHEN cus.Mrecommend IS NOT NULL THEN cus.MRecommend  ELSE 0 END
		, CASE WHEN cus.Srecommend IS NOT NULL THEN cus.SRecommend  ELSE 0 END
		, st.SiteID
from bodb02.dbo.customer cus with(nolock)
	inner join bodb02.dbo.Site st with(nolock) on cus.Site = st.Site
where ${SourceID} = 2 and cus.CustID = ${CustID};</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert table: FactCustStatsInfo" enabled="true">
          <stringProp name="dataSource">AccountDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert into dbo.FactCustStatsInfo (RptDate,LeagueID,SportType,LiveStatus,BetType,MemberTurnover,MemberWinloss,MemberCommission,BetCount,TicketStatus,BetFromID,CustID,CurrencyID,SiteID)
select        CAST(DATEADD(DAY, ${RptNumDay}, CAST(GETDATE() AS DATE)) AS VARCHAR) + &apos;${TransHour}&apos;
		, ${LeagueID}
		, ${SportType}
		, CASE WHEN ${RptNumDay} &gt;= 29 THEN 1 ELSE 0 END
		, ${BetTypeID}	
		, ${Turnover}
		, ${Winloss}
		, 0
		, ${BetCount}
		, ${StatusID}
		, 1
		, ${CustID}
		, cus.Currency
		, st.SiteID
from bodb02.dbo.customer cus with(nolock)
	inner join bodb02.dbo.Site st with(nolock) on cus.Site = st.Site
where ${SourceID} = 3 and cus.CustID = ${CustID};

</stringProp>
