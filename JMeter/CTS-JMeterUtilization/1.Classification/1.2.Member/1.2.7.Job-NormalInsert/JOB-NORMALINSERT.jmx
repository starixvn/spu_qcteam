          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert into AssociationByDevice (CTSCustID,DCSDeviceID,SubscriberID,CreatedTime,InsertTime) 
select CTSCustID,20250521001,SubscriberID,&apos;${CurrentDateTime}&apos;,&apos;${CurrentDateTime}&apos; 
from CTSCustomer
where CustID IN (${CustIDList}) and CustID IN (23933030, 23933068, 23997009) -- Hedging
;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
