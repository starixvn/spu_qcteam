      <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Get CustID List Info">
        <stringProp name="scriptLanguage">groovy</stringProp>
        <stringProp name="parameters">CustList</stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="script">String readFileToString(String filePath) {
    String content = &apos;&apos;
    try {
        content = new File(filePath).text
    } catch (Exception e) {
        log.error(&quot;Error reading file: ${e.message}&quot;)
    }
    return content
}

def filePath = &apos;${CustIDListInfoPath}&apos;
def custIDList = readFileToString(filePath)
vars.put(&quot;CustIDList&quot;, custIDList)
log.info(&quot;File Path: &quot; + filePath);
log.info(&quot;CustIDList: &quot; + custIDList);</stringProp>
      </JSR223PreProcessor>
