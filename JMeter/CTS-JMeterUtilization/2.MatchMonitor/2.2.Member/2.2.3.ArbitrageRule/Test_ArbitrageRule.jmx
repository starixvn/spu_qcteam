        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="Get Trans Info" enabled="true">
          <stringProp name="filename">${NewBettransInfo_ScPath}</stringProp>
          <stringProp name="fileEncoding">utf-8</stringProp>
          <stringProp name="variableNames">MatchNo,TransHour,LiveIndicator,LiveHomeScore,LiveAwayScore,StatusID,Status,BetTypeID,BetID,BetCheck,BetTeam,BetFrom,StakeRM,Hdp1,Hdp2,OddsId,Odds,RefNo,CustID</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <stringProp name="delimiter">,</stringProp>
          <boolProp name="quotedData">false</boolProp>
          <boolProp name="recycle">false</boolProp>
