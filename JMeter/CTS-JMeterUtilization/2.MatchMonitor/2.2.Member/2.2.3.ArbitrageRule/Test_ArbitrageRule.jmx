          <stringProp name="query">INSERT IGNORE INTO AssociationByAI (AssType,FromCustID,ToCustID,CreatedDate)
SELECT 1, ${CustID},${ToCustID},&apos;${CurrentDateTime}&apos;
FROM CTSCustomer AS c
where c.CustID = ${CustID} and ${AssTypeID} = 2
and ${DeviceID} is null;</stringProp>
