        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Get MIN SequenceID" enabled="true">
          <stringProp name="dataSource">TransDB</stringProp>
          <stringProp name="queryType">Prepared Select Statement</stringProp>
          <stringProp name="query">select MIN(b.SequenceID) 
from dbo.bettrans b with(nolock) 
	inner join dbo.match m with(nolock) on m.matchid = b.matchid
where m.MatchCode like &apos;${MatchCode}%&apos; and CustID IN (${CustIDList});</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable">MINSequenceID_Raw</stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree>
          <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="BeanShell PostProcessor" enabled="true">
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <boolProp name="resetInterpreter">false</boolProp>
            <stringProp name="script">String minSequenceID_raw = vars.get(&quot;MINSequenceID_Raw&quot;);
String minSequenceID = minSequenceID_raw.replaceAll(&quot;[^0-9]&quot;, &quot;&quot;); // Lọc bỏ ký tự không phải số
vars.put(&quot;MINSequenceID&quot;, minSequenceID);

log.info(&quot;MINSequenceID_Raw: &quot; + minSequenceID_raw);
log.info(&quot;MINSequenceID: &quot; + minSequenceID);</stringProp>
          </BeanShellPostProcessor>
          <hashTree/>
        </hashTree>
