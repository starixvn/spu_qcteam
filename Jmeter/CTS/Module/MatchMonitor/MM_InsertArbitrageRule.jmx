        <hashTree>
          <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="Get Trans Info">
            <stringProp name="filename">${TransInfoPath}</stringProp>
            <stringProp name="fileEncoding">utf-8</stringProp>
            <stringProp name="variableNames">SequenceID,TransID,TransDate,CustID,Stake,Odds</stringProp>
            <boolProp name="ignoreFirstLine">false</boolProp>
            <stringProp name="delimiter">,</stringProp>
            <boolProp name="quotedData">false</boolProp>
            <boolProp name="recycle">false</boolProp>
            <boolProp name="stopThread">true</boolProp>
            <stringProp name="shareMode">shareMode.all</stringProp>
          </CSVDataSet>
          <hashTree/>
          <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl: MatchMonitorStagingArbitrageNonLive">
            <stringProp name="dataSource">${MySQL_DB_CTS_DataCenter}</stringProp>
            <stringProp name="queryType">Update Statement</stringProp>
            <stringProp name="query">INSERT IGNORE INTO MatchMonitorStagingArbitrageNonLive
(SequenceID,TransID,TransDate,MatchID,SportType,ScoreDiff,BettypeID,BetID,Betteam,CustID,Stake,GroupID,LiveHomeScore,LiveAwayScore,EventDate,KickOffTime,EventStatus,HomeID,AwayID,LeagueID,InsertTime,LeagueName,IsMajorLeague,Hdp,Hdp1,Hdp2)
SELECT ${SequenceID},${TransID},&apos;${TransDate}&apos;,22081996,1,0,1,0,&apos;h&apos;,${CustID},${Stake},0,0,0,&apos;${CurrentDateTime}&apos;,&apos;${CurrentDateTime}&apos;,&apos;running&apos;,11,22,33,&apos;${CurrentDateTime}&apos;,&apos;League001&apos;,1,&apos;0.5&apos;,&apos;0.5&apos;,&apos;0&apos;;</stringProp>
            <stringProp name="queryArguments"></stringProp>
            <stringProp name="queryArgumentsTypes"></stringProp>
            <stringProp name="variableNames"></stringProp>
            <stringProp name="resultVariable"></stringProp>
            <stringProp name="queryTimeout"></stringProp>
            <stringProp name="resultSetMaxRows"></stringProp>
            <stringProp name="resultSetHandler">Store as String</stringProp>
          </JDBCSampler>
          <hashTree/>
        </hashTree>
      </hashTree>
