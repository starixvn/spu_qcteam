        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl dbo.bettrans" enabled="true">
          <stringProp name="dataSource">TransDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert into dbo.bettrans (winlostdate,transdate,matchid,liveindicator,livehomescore,liveawayscore,statusid,status,bettype,betid,betcheck,betteam,betfrom,oddstype,oddsid,odds,hdp1,hdp2,stake,actualrate,custid,username,recommend,mrecommend,srecommend,currency,currencyName,ip,refno) 
select	&apos;${TransDate}&apos;,
		&apos;${TransDate}&apos;,
		CASE WHEN ${BetTypeID} = 29 THEN 29 WHEN ${BetTypeID} != 29 THEN m.MatchID END,
		${LiveIndicator},
		${LiveHomeScore},
		${LiveAwayScore},
		${StatusID},
		&apos;${Status}&apos;,
		${BetTypeID},
		CASE WHEN ${BetTypeID} = 29 THEN NULL WHEN ${BetTypeID} != 29 THEN ${BetID} END,
		&apos;${BetCheck}&apos;,
		&apos;${BetTeam}&apos;,
		&apos;${BetFrom}&apos;,
		2,/*DEC*/
		&apos;${OddsId}&apos;,
		&apos;${Odds}&apos;,
		&apos;${Hdp1}&apos;,
		&apos;${Hdp2}&apos;,
		${StakeRM},
		1,
		${CustID},
		cus.username,
		cus.recommend,
		cus.mrecommend,
		cus.srecommend,
		cus.currency,
		ex.currency,
		null,
		${RefNo}
from dbo.match m with(nolock) cross join 
     (CustDB.dbo.customer cus with(nolock)
	inner join CustDB.dbo.Exchange ex with(nolock) on ex.ExchangeId = cus.currency)
where m.MatchCode like &apos;NATEST MM GB%&apos; and RIGHT(m.MatchCode, 3) = &apos;${MatchNo}&apos;
	and cus.CustID = ${CustID}
;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
      </hashTree>
