        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert Association By 3MatchesLast7d and IPLast3d" enabled="true">
          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">/*Copy-paste this code to
- SP1: TESTDB06.bodb02.dbo.CTS_Association_GetBySharedMatches
	INSERT INTO #tmpAssociation (CustID1, CustID2)
	SELECT FromCustID, ToCustID
	FROM bodb02.dbo.CTS_RawAssMatchIP  r 
		INNER JOIN #tmpCustIds t on t.CustID = r.FromCustID or t.CustID = r.ToCustID		
	WHERE r.AssTypeID = 5;
- SP2: TESTDB06.bodb02.dbo.CTS_Association_IpSharedLast3Days
	INSERT INTO #tmp_Association (CustID1, CustID2, IP) 
	SELECT FromCustID, ToCustID, &apos;10.200.18.200&apos;
	FROM bodb02.dbo.CTS_RawAssMatchIP  r 
		INNER JOIN #tmp_CustID t on t.CustID = r.FromCustID or t.CustID = r.ToCustID		
	WHERE r.AssTypeID = 6;
*/

INSERT INTO bodb02.dbo.CTS_RawAssMatchIP
SELECT ${AssTypeID}, ${CustID}, ${ToCustID}
WHERE ${AssTypeID} IN (5, 6);
;</stringProp>
