        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="Get Ticket Info" enabled="true">
          <stringProp name="filename">${NewBettransInfoPath}</stringProp>
          <stringProp name="fileEncoding">utf-8</stringProp>
          <stringProp name="variableNames">MatchNo,TransDate,LiveIndicator,LiveHomeScore,LiveAwayScore,StatusID,Status,BetTypeID,BetCheck,BetTeam,BetFrom,StakeRM,Hdp1,Hdp2,OddsId,Odds,RefNo,CustID</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <stringProp name="delimiter">,</stringProp>
          <boolProp name="quotedData">false</boolProp>
