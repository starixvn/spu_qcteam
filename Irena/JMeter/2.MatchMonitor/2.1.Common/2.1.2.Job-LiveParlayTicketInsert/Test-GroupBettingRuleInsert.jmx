        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl dbo.bettransm" enabled="true">
          <stringProp name="dataSource">TransDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert into dbo.bettransm (winlostdate,transdate,matchid,liveindicator,livehomescore,liveawayscore,statusid,status,bettype,betcheck,betteam,betfrom,stake,hdp1,hdp2,oddsid,odds,actualrate,custid,refno,creator) 
select    &apos;${TransDate}&apos;,
		&apos;${TransDate}&apos;,
		m.MatchID,
		${LiveIndicator},
		${LiveHomeScore},
		${LiveAwayScore},
		${StatusID},
		&apos;${Status}&apos;,
		${BetTypeID},
		CASE when ${BetTypeID} IN (1,3,7,8,20) THEN &apos;&apos; else ${BetID} end,
		&apos;${BetTeam}&apos;,
		&apos;${BetFrom}&apos;,
		${StakeRM},
		&apos;${Hdp1}&apos;,
		&apos;${Hdp2}&apos;,
		${OddsId},
		&apos;${Odds}&apos;,
		1,
		${CustID},
		${RefNo},
		8
from dbo.match m with(nolock) 
where m.MatchCode like &apos;NATEST MM GB%&apos; and RIGHT(m.MatchCode, 3) = &apos;${MatchNo}&apos;
     and exists (select 1 from dbo.bettrans b with(nolock) where b.MatchID = 29 and b.CustID = ${CustID} and b.RefNo = ${RefNo})
;</stringProp>
