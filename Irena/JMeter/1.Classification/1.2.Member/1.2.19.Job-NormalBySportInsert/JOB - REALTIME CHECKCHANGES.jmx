        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Execute SP: CTS_NormalClassification_RealTime_CheckChanges" enabled="true">
          <stringProp name="dataSource">VR2ModelDB</stringProp>
          <stringProp name="queryType">Callable Statement</stringProp>
          <stringProp name="query">DECLARE	@return_value int,
		@NextScannedDateTime1 datetime2(7),
		@NextScannedDateTime2 datetime2(7),
		@NextScannedDateTime3 datetime2(7),
		@NextScannedDateTime4 datetime2(7)
EXEC	@return_value = dbo.CTS_NormalClassification_RealTime_CheckChanges
		@NextScannedDateTime1 = @NextScannedDateTime1 OUTPUT,
		@NextScannedDateTime2 = @NextScannedDateTime2 OUTPUT,
		@NextScannedDateTime3 = @NextScannedDateTime3 OUTPUT,
		@NextScannedDateTime4 = @NextScannedDateTime4 OUTPUT
SELECT	@NextScannedDateTime1 as N&apos;@NextScannedDateTime1&apos;,
		@NextScannedDateTime2 as N&apos;@NextScannedDateTime2&apos;,
		@NextScannedDateTime3 as N&apos;@NextScannedDateTime3&apos;,
		@NextScannedDateTime4 as N&apos;@NextScannedDateTime4&apos;
SELECT	&apos;Return Value&apos; = @return_value
GO</stringProp>
