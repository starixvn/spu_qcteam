        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert table: ODS_bettrans_final_SiteDB03_batch01" enabled="true">
          <stringProp name="dataSource">ODSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert into dbo.ODS_bettrans_final_SiteDB03_batch01 (WinlostDate,TransDate,ModifiedDate,MatchID,LeagueID,SportType,ProductID,TransID,BetType,Stake,actual_stake,Winlost,BetCount,ActualRate,Status,ExternalBet,CustID,Currency,Recommend,Mrecommend,Srecommend,SiteID)
select      CAST(DATEADD(DAY, ${RptNumDay}, CAST(GETDATE() AS DATE)) AS VARCHAR) + &apos;${TransHour}&apos;
		, CAST(DATEADD(DAY, ${RptNumDay}, CAST(GETDATE() AS DATE)) AS VARCHAR) + &apos;${TransHour}&apos;
		, CAST(DATEADD(DAY, ${RptNumDay}, CAST(GETDATE() AS DATE)) AS VARCHAR) + &apos;${TransHour}&apos;
		, ${MatchID}
		, ${LeagueID}
		, ${SportType}
		, ${ProductID}
		, ${TransID}
		, ${BetTypeID}	
		, 0
		, 0 
		, 0
		, 0
		, 1
		, &apos;${Status}&apos;
		, 1
		, ${CustID}
		, cus.Currency
		, CASE WHEN cus.Recommend IS NOT NULL THEN cus.Recommend  ELSE 0 END
		, CASE WHEN cus.Mrecommend IS NOT NULL THEN cus.MRecommend  ELSE 0 END
		, CASE WHEN cus.Srecommend IS NOT NULL THEN cus.SRecommend  ELSE 0 END
		, st.SiteID
from bodb02.dbo.customer cus with(nolock)
	inner join bodb02.dbo.Site st with(nolock) on cus.Site = st.Site
where ${SourceID} = 3 and cus.CustID = ${CustID}; </stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
          <stringProp name="TestPlan.comments">This is data for Deposit</stringProp>
        </JDBCSampler>
