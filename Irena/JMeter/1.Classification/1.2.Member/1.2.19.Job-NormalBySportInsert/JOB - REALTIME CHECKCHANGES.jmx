      <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Get Member List Info" enabled="true">
        <stringProp name="scriptLanguage">groovy</stringProp>
        <stringProp name="parameters">CustList</stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="script">String readFileToString(String filePath) {
    String content = &apos;&apos;
    try {
        content = new File(filePath).text
    } catch (Exception e) {
        log.error(&quot;Error reading file: ${e.message}&quot;)
    }
    return content
}

def filePath = &apos;${MemberListInfoPath}&apos;
def memberList = readFileToString(filePath)
vars.put(&quot;MemberList&quot;, memberList)</stringProp>
      </JSR223PreProcessor>
