        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl dbo.bettrans">
          <stringProp name="dataSource">TransDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert into dbo.bettrans (winlostdate,transdate,matchid,liveindicator,livehomescore,liveawayscore,statusid,status,bettype,betid,betteam,betfrom,oddstype,odds,hdp1,hdp2,stake,actualrate,custid,username,recommend,mrecommend,srecommend,currency,currencyName,oddsid,ip,refno) 
select		&apos;${TransDate}&apos;,
		&apos;${TransDate}&apos;,
		m.matchid,
		${LiveIndicator},
		${LiveHomeScore},
		${LiveAwayScore},
		0,
		&apos;${Status}&apos;,
		${BetTypeID},
		${BetID},
		&apos;${BetTeam}&apos;,
		&apos;i&apos;,
		2,
		&apos;0.5&apos;,
		&apos;0.5&apos;,
		0,
		500,
		1,
		${CustID},
		cus.username,
		cus.recommend,
		cus.mrecommend,
		cus.srecommend,
		cus.currency,
		ex.currency as CurrencyName,
		0,
		null,
		0
from bodb02.dbo.match as m with(nolock)
	inner join CustDB.dbo.customer cus with(nolock) on cus.CustID = ${CustID}
	inner join CustDB.dbo.Exchange ex with(nolock) on ex.ExchangeId = cus.currency
where m.MatchCode like &apos;NATEST SharedMatches%&apos; and RIGHT(m.MatchCode, 3) = &apos;${MatchNo}&apos;-- 101,102,111
;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl dbo.bettrans">
          <stringProp name="dataSource">TransDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert into dbo.bettrans (winlostdate,transdate,matchid,liveindicator,livehomescore,liveawayscore,statusid,status,bettype,betid,betteam,betfrom,oddstype,odds,hdp1,hdp2,stake,actualrate,custid,username,recommend,mrecommend,srecommend,currency,currencyName,oddsid,ip,refno) 
select		&apos;${TransDate}&apos;,
		&apos;${TransDate}&apos;,
		m.matchid,
		${LiveIndicator},
		${LiveHomeScore},
		${LiveAwayScore},
		0,
		&apos;${Status}&apos;,
		${BetTypeID},
		${BetID},
		&apos;${BetTeam}&apos;,
		&apos;i&apos;,
		2,
		&apos;0.5&apos;,
		&apos;0.5&apos;,
		0,
		500,
		1,
		${CustID},
		cus.username,
		cus.recommend,
		cus.mrecommend,
		cus.srecommend,
		cus.currency,
		ex.currency as CurrencyName,
		0,
		null,
		0
from bodb02.dbo.match14 as m with(nolock)
	inner join CustDB.dbo.customer cus with(nolock) on cus.CustID = ${CustID}
	inner join CustDB.dbo.Exchange ex with(nolock) on ex.ExchangeId = cus.currency
where m.MatchCode like &apos;NATEST SharedMatches%&apos; and RIGHT(m.MatchCode, 3) = &apos;${MatchNo}&apos;-- 106,116,124
;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
