      <hashTree>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="Get Match Info" enabled="true">
          <stringProp name="filename">${NewMatchInfoPath}</stringProp>
          <stringProp name="fileEncoding">utf-8</stringProp>
          <stringProp name="variableNames">No,SportType,LeagueID,HomeID,AwayID</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <stringProp name="delimiter">,</stringProp>
          <boolProp name="quotedData">false</boolProp>
          <boolProp name="recycle">false</boolProp>
          <boolProp name="stopThread">true</boolProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
        </CSVDataSet>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl dbo.match " enabled="true">
          <stringProp name="dataSource">MatchDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert into dbo.match (leagueid,homeid,homeid2,awayid,awayid2,eventstatus,eventdate,kickofftime,GlobalShowTime,creator,matchcode,sporttype,DisplayMode,LeaguePatternID,HomeDisplayPatternID,AwayDisplayPatternID,IsNeutral,HasLive)
select 	${LeagueID}
	,	${HomeID}
	,	${HomeID}
	,	${AwayID}
	,	${AwayID}
	,	&apos;completed&apos;
	,	&apos;${CurrentDateTime}&apos;
	,	&apos;${CurrentDateTime}&apos;
	,	&apos;${CurrentDateTime}&apos;
	,	8
	,	CONCAT(&apos;NATEST SharedMatches&apos;, &apos; &apos;, &apos;${No}&apos;) 
	,	${SportType}
	,	1
	,	1
	,	1
	,	1
	,	0
	,	1
where ${SportType} IN (1, 2, 43)
;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
      </hashTree>
