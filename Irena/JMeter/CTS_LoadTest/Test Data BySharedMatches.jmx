select matchid,leagueid,homeid,homeid2,awayid,awayid2,&apos;completed&apos;,eventdate,kickofftime,GlobalShowTime,creator,matchcode,sporttype,DisplayMode,LeaguePatternID,HomeDisplayPatternID,AwayDisplayPatternID,IsNeutral
from dbo.match with(nolock)
where matchcode like &apos;NAGA TEST MATCH%&apos; and eventdate in (&apos;${Last6d}&apos;, &apos;${Last7d}&apos;) 
;</stringProp>
          <stringProp name="queryArguments"></stringProp>
