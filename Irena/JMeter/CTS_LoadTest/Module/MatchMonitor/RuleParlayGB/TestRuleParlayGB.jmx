          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">delete m
from MatchMonitor as m
	inner join MatchMonitorDetails as md on m.MatchID = md.MatchID
where md.Reason = 5 and md.ListRefNo between 28950001 and 28951194;
</stringProp>
          <stringProp name="queryArguments"></stringProp>
