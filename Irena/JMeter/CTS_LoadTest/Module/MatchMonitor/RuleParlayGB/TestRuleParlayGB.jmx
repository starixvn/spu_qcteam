          <stringProp name="variableNames">MatchNo,LiveIndicator,TransDate,LiveHomeScore,LiveAwayScore,StatusID,Status,BetTypeID,BetID,BetTeam,RefNo,BetCheck,IsMain,CustID</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <stringProp name="delimiter">,</stringProp>
          <boolProp name="quotedData">false</boolProp>
