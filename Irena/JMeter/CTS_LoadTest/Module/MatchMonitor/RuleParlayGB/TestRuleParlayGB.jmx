        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl dbo.match " enabled="true">
          <stringProp name="dataSource">MatchDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">/*Tạo match mới như bình thường*/
insert into dbo.match (leagueid,homeid,homeid2,awayid,awayid2,eventstatus,eventdate,kickofftime,GlobalShowTime,creator,matchcode,sporttype,DisplayMode,LeaguePatternID,HomeDisplayPatternID,AwayDisplayPatternID,IsNeutral,HasLive)
select 	${LeagueID}
	,	${HomeID}
	,	${HomeID}
	,	${AwayID}
	,	${AwayID}
	,	&apos;running&apos;
	,	&apos;${CurrentDate}&apos;
	,	&apos;${CurrentDateTime}&apos;
	,	&apos;${CurrentDateTime}&apos;
	,	8
	,	CONCAT(&apos;NATEST PARLAY MATCH&apos;, &apos; &apos;, &apos;${No}&apos;) 
	,	${SportType}
	,	1
	,	1
	,	1
	,	1
	,	0
	,	1
;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
