        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl dbo.match " enabled="false">
          <stringProp name="dataSource">MatchDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">/*Tạo match mới như bình thường*/
insert into dbo.match (sporttype,leagueid,homeid,homeid2,awayid,awayid2,eventstatus,eventdate,kickofftime,GlobalShowTime,creator,matchcode,DisplayMode,LeaguePatternID,HomeDisplayPatternID,AwayDisplayPatternID,IsNeutral,HasLive) VALUES
(1,50,5,5,6,6,&apos;running&apos;,&apos;${CurrentDate}&apos;,&apos;${CurrentDateTime}&apos;,&apos;${CurrentDateTime}&apos;,8,&apos;NATEST PARLAY MATCH PERF 201&apos;,1,1,1,1,0,1),
(1,3,35,35,36,36,&apos;running&apos;,&apos;${CurrentDate}&apos;,&apos;${CurrentDateTime}&apos;,&apos;${CurrentDateTime}&apos;,8,&apos;NATEST PARLAY MATCH PERF 202&apos;,1,1,1,1,0,1),
(2,4045,1967,1967,1968,1968,&apos;running&apos;,&apos;${CurrentDate}&apos;,&apos;${CurrentDateTime}&apos;,&apos;${CurrentDateTime}&apos;,8,&apos;NATEST PARLAY MATCH PERF 203&apos;,1,1,1,1,0,1);</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
