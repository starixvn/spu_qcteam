        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert Ass by Device">
          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">insert ignore into AssociationByDevice (CTSCustID,DCSDeviceID,SubscriberID,CreatedTime,InsertTime) 
select 	cus.CTSCustID
	,	240925001
	,	cus.SubscriberID
	,	&apos;${CurrentDateTime}&apos;
	,	&apos;${CurrentDateTime}&apos;
from CTSCustomer as cus
where cus.CustID IN (${CustList});
</stringProp>
          <stringProp name="queryArguments"></stringProp>
