        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl dbo.bettransm">
          <stringProp name="dataSource">TransDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">/*Tạo parlay trans có: MatchID=MatchID đã tạo, RefNo=RefNo của main trans có MatchID=29, các info khác như bình thường*/
insert into dbo.bettransm (winlostdate,transdate,matchid,liveindicator,livehomescore,liveawayscore,statusid,status,bettype,betcheck,betteam,betfrom,oddsid,odds,hdp1,hdp2,stake,actualrate,custid,refno,creator) 
select      &apos;${TransDate}&apos;,
		&apos;${TransDate}&apos;,
		m.MatchID,
		0,
		0,
		0,
		${StatusID},
		&apos;${Status}&apos;,
		${BetTypeID},
		CASE WHEN ${BetTypeID} IN (1,3,7,8,20) THEN &apos;&apos; ELSE ${BetID} END,
		&apos;${BetTeam}&apos;,
		&apos;i&apos;,
		0,-- oddsid
		${Odds},-- odds
		&apos;0.5&apos;,-- hdp1
		0,-- hdp2
		${Stake},-- stake
		1,-- actual rate
		${CustID},
		${RefNo},
		8
from dbo.match m with(nolock) 
where m.MatchCode like &apos;NATEST PARLAY MATCH PERF%&apos; and RIGHT(m.MatchCode, 3) = &apos;${MatchNo}&apos;
;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl dbo.bettrans">
          <stringProp name="dataSource">TransDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">/*Tạo main trans có: MatchID=29, BetType=29, BetCheck=2(combo 2) hoặc BetCheck=4(combo 3), RefNo=con số quy định*/
/*VD: Combo 3 --&gt; 3 parlay trans --&gt; chỉ tạo 1 main trans*/
insert into dbo.bettrans (winlostdate,transdate,matchid,liveindicator,livehomescore,liveawayscore,statusid,status,bettype,betid,betteam,betfrom,oddstype,odds,hdp1,hdp2,stake,actualrate,custid,username,recommend,mrecommend,srecommend,currency,currencyName,oddsid,ip,refno,betcheck) 
select		&apos;${TransDate}&apos;,
		&apos;${TransDate}&apos;,
		29,
		0,
		0,
		0,
		${StatusID},
		&apos;${Status}&apos;,
		29,
		null,
		1,
		&apos;i&apos;,
		2,-- DEC
		0,-- odds
		${Hdp1},-- hdp1
		${Hdp2},-- hdp2
		${Stake},-- stake
		1,-- actual rate
		${CustID},
		cus.username,
		cus.recommend,
		cus.mrecommend,
		cus.srecommend,
		cus.currency,
		ex.currency as CurrencyName,
		${OddsId}, --- OddsId
		null,
		${RefNo},
		${BetCheck}
from CustDB.dbo.customer cus with(nolock)
	inner join CustDB.dbo.Exchange ex with(nolock) on ex.ExchangeId = cus.currency
where cus.CustID = ${CustID} and ${IsMain} = 1
;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
      </hashTree>
