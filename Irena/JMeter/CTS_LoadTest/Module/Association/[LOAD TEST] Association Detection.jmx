                <stringProp name="Header.name">cookie</stringProp>
                <stringProp name="Header.value">.NAPFORMSAUTH_NAPLICENSEE=${licensee};ASP.NET_SessionId=${sessionId}</stringProp>
              </elementProp>
            </collectionProp>
