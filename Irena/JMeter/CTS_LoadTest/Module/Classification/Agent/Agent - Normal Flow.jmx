        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Clean tbl: ODS_bettrans_final_SiteDB01_batch01" enabled="true">
          <stringProp name="dataSource">ODSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">delete bt
from dbo.ODS_bettrans_final_SiteDB01_batch01 bt 
	inner join bodb02.dbo.customer cus on cus.custid = bt.custid
where bt.CustID IN (${CustList}) OR cus.recommend in (${CustList});</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
