        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert data tbl: CTS_CustFirstbetDate" enabled="true">
          <stringProp name="dataSource">bodb_Account</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert into bodb_Account.dbo.CTS_CustFirstbetDate (CustID, FirstBetDate) 
select   CustID
       , CASE	WHEN CustID IN (791050,791054) THEN DATEADD(DAY, -1, &apos;${SysDate}&apos;) -- deposit, deviation of first bet = 1d
			WHEN CustID IN (832131,832132) THEN DATEADD(DAY, -2, &apos;${SysDate}&apos;) -- deposit, deviation of first bet = 2d
			WHEN CustID IN (832134,832138) THEN DATEADD(DAY, -3, &apos;${SysDate}&apos;) -- deposit, deviation of first bet = 3d FAIL
			WHEN CustID IN (835062,835064) THEN DATEADD(DAY, -4, &apos;${SysDate}&apos;) -- deposit, deviation of first bet = 4d --&gt; ignore
			WHEN CustID IN (8078245,8078256) THEN DATEADD(DAY, -7, &apos;${SysDate}&apos;) -- credit, deviation of first bet = 7d --&gt; ignore FAIL
			WHEN CustID IN (8094971,8095010) THEN DATEADD(DAY, -8, &apos;${SysDate}&apos;) -- credit, deviation of first bet = 8d
			WHEN CustID IN (8106514,8305518) THEN DATEADD(DAY, -9, &apos;${SysDate}&apos;) -- credit, deviation of first bet = 9d
			WHEN CustID IN (8311309,8311318) THEN DATEADD(DAY, -13, &apos;${SysDate}&apos;) -- credit, deviation of first bet = 13d
			WHEN CustID IN (8311321,8311324) THEN DATEADD(DAY, -14, &apos;${SysDate}&apos;) -- credit, deviation of first bet = 14d --&gt; FAIL
			WHEN CustID IN (8311900,8311925) THEN DATEADD(DAY, -15, &apos;${SysDate}&apos;) -- credit, deviation of first bet = 15d --&gt; ignore
		 END
from bodb02.dbo.custinfo with(nolock)
where CustID IN (791050,791054,832131,832132,832134,832138,835062,835064,8078245,8078256,8094971,8095010,8106514,8305518,8311309,8311318,8311321,8311324,8311900,8311925);</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert data tbl: LoginTransactionSummary (current not satisfy)" enabled="true">
          <stringProp name="dataSource">DCS_DataTrace</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">/*CurrentDate not satisfy*/
insert ignore into DCS_DataTrace.LoginTransactionSummary (TransDate,SubscriberID,AccountID,DeviceID,Flagged,TotalTrans,FirstLoginTransTime,LastLoginTransTime,CreatedTime,ModifiedTime,FlaggedGroupID) 
select  CURRENT_DATE()
	, ca.SubscriberID
	, ca.AccountID
	, 100
	, 8
	, 20
	, &apos;${CurrentDateTime}&apos;
	, &apos;${CurrentDateTime}&apos;
	, &apos;${CurrentDateTime}&apos;
	, &apos;${CurrentDateTime}&apos;
	, 2
from CTS_DataCenter.CustDCSAccount as ca
   inner join CTS_DataCenter.CTSCustomer as c on c.CTSCustID = ca.CTSCustID
where c.CustID IN (791050,8078245)
;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert data tbl: CTS_CustFirstbetDate (current not satisfy)" enabled="true">
          <stringProp name="dataSource">bodb_Account</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert into bodb_Account.dbo.CTS_CustFirstbetDate (CustID, FirstBetDate) 
select   CustID
       , GETDATE()
from bodb02.dbo.custinfo with(nolock)
where CustID IN (791050,8078245);</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
