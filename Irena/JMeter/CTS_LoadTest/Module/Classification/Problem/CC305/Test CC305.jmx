      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="[2. Prepare existing data]" enabled="true">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <longProp name="ThreadGroup.duration">100</longProp>
        <longProp name="ThreadGroup.delay">0</longProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">false</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <intProp name="LoopController.loops">-1</intProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="Get data from file" enabled="true">
          <stringProp name="filename">${Data}</stringProp>
          <stringProp name="fileEncoding">utf-8</stringProp>
          <stringProp name="variableNames">CustID,DeviceID,Flagged,TotalTrans,FlaggedGroupID</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <stringProp name="delimiter">,</stringProp>
          <boolProp name="quotedData">false</boolProp>
          <boolProp name="recycle">false</boolProp>
          <boolProp name="stopThread">true</boolProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
        </CSVDataSet>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert data tbl: Account" enabled="false">
          <stringProp name="dataSource">DCS_DataCenter</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert ignore into DCS_DataCenter.Account (LoginName,SubscriberID,SubscriberType,CreatedTime,LastLoginTime,CreatedDate,InsertTime,IsCTSTransformed) 
select   c.Username
	, c.SubscriberID
	, c.IsLicensee
	, &apos;${CurrentDateTime}&apos;
	, &apos;${CurrentDateTime}&apos;
	, c.CreatedDate
	, &apos;${CurrentDateTime}&apos;
	, 1
from CTS_DataCenter.CTSCustomer as c
where c.CustID = ${CustID}
;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert data tbl: CustDCSAccount" enabled="false">
          <stringProp name="dataSource">DCS_DataCenter</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert ignore into CTS_DataCenter.CustDCSAccount (CTSCustID,AccountID,SubscriberID,InsertTime) 
select   c.CTSCustID
	, a.AccountID
	, c.SubscriberID
	, &apos;${CurrentDateTime}&apos;
from CTS_DataCenter.CTSCustomer as c
   inner join DCS_DataCenter.Account as a on a.SubscriberID = c.SubscriberID AND a.LoginName = c.Username
where c.CustID = ${CustID}
;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert data tbl: LoginTransactionSummary" enabled="true">
          <stringProp name="dataSource">DCS_DataTrace</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">/*Compare to ScanDate must be enough 90 last days from TransDate. SysDate -&gt; Credit: from = SysDate - 8, to = SysDate - 14; Deposit: from = SysDate - 1, to = SysDate - 3*/
insert ignore into DCS_DataTrace.LoginTransactionSummary (TransDate,SubscriberID,AccountID,DeviceID,Flagged,TotalTrans,FirstLoginTransTime,LastLoginTransTime,CreatedTime,ModifiedTime,FlaggedGroupID) 
select   CASE	WHEN ${CustID} IN (791050,791054) THEN DATE_ADD(&apos;${SysDate}&apos;, INTERVAL -1 DAY) -- deposit, deviation of first bet = 1dx
			WHEN ${CustID} IN (832131,832132) THEN DATE_ADD(&apos;${SysDate}&apos;, INTERVAL -2 DAY) -- deposit, deviation of first bet = 2d
			WHEN ${CustID} IN (832134,832138) THEN DATE_ADD(&apos;${SysDate}&apos;, INTERVAL -3 DAY) -- deposit, deviation of first bet = 3dx
			WHEN ${CustID} IN (835062,835064) THEN DATE_ADD(&apos;${SysDate}&apos;, INTERVAL -4 DAY) -- deposit, deviation of first bet = 4d --&gt; ignore
			WHEN ${CustID} IN (8078245,8078256) THEN DATE_ADD(&apos;${SysDate}&apos;, INTERVAL -7 DAY) -- credit, deviation of first bet = 7d --&gt; ignore
			WHEN ${CustID} IN (8094971,8095010) THEN DATE_ADD(&apos;${SysDate}&apos;, INTERVAL -8 DAY) -- credit, deviation of first bet = 8dx
			WHEN ${CustID} IN (8106514,8305518) THEN DATE_ADD(&apos;${SysDate}&apos;, INTERVAL -9 DAY) -- credit, deviation of first bet = 9d
			WHEN ${CustID} IN (8311309,8311318) THEN DATE_ADD(&apos;${SysDate}&apos;, INTERVAL -13 DAY) -- credit, deviation of first bet = 13d
			WHEN ${CustID} IN (8311321,8311324) THEN DATE_ADD(&apos;${SysDate}&apos;, INTERVAL -14 DAY) -- credit, deviation of first bet = 14dx
			WHEN ${CustID} IN (8311900,8311925) THEN DATE_ADD(&apos;${SysDate}&apos;, INTERVAL -15 DAY) -- credit, deviation of first bet = 15d --&gt; ignore
		END
	, ca.SubscriberID
	, ca.AccountID
	, ${DeviceID}
	, ${Flagged}
	, ${TotalTrans}
	, &apos;${CurrentDateTime}&apos;
	, &apos;${CurrentDateTime}&apos;
	, &apos;${CurrentDateTime}&apos;
	, &apos;${CurrentDateTime}&apos;
	, ${FlaggedGroupID}
from CTS_DataCenter.CustDCSAccount as ca
   inner join CTS_DataCenter.CTSCustomer as c on c.CTSCustID = ca.CTSCustID
where c.CustID = ${CustID}
;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
      </hashTree>
