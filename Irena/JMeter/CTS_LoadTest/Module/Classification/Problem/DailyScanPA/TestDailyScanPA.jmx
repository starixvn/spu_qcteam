        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert data tbl: Customer_DangerousScore" enabled="true">
          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">INSERT INTO Customer_DangerousScore (CustID,IsLicensee,DangerousScore,CreatedDate,LastModifiedDate,ClassifiedScore,ClassifiedDate) 
SELECT c.CustID, c.IsLicensee, 0.9111, &apos;${CurrentDateTime}&apos;,&apos;${CurrentDateTime}&apos;,0.9111,&apos;${CurrentDateTime}&apos;
FROM CTSCustomer AS c 
WHERE c.CustID IN (8313051,8313055,8313065,8313071,8313078,8318370,1715430,1766215,1773953,1773986,1863227,1944859)
;
</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
