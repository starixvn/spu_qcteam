          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">INSERT INTO CTSCustomerClassification_History (CustID, CTSCustID, ParentID, CategoryID, LastModifiedDate, LastModifiedBy, InsertDate, IsMarkedDirectly, IsFromTVS, IsFromCTS, IsFromTW, IsFromAI, IsFromImperva, IssueTypeID, TVSRequestID, SportType, IsParlay, TurnoverRM, WinlossRM, BetCount, ActiveDays, TargetCC, Remark, IsDataChanged)
SELECT distinct ${CustID}
	,	c.CTSCustID
     ,	${ParentID}
     ,	${CategoryID}
     ,	&apos;${CurrentDateTime}&apos;
     ,	${SystemID}
     ,	&apos;${CurrentDateTime}&apos;
     ,    ${IsMarkedDirectly}
     ,	${IsFromTVS}
     ,	${IsFromCTS}
     ,	${IsFromTW}
     ,	${IsFromAI}
     ,	${IsFromImperva}
     ,	${IssueTypeID}
     ,	${TVSRequestID}
     ,	${SportType}
     ,	${IsParlay}
     ,    10000
     ,    1000
     ,    10
     ,    5
     ,    100 
     , 	&apos;${Remark}&apos;
     ,	1
FROM CTSCustomer AS c 
WHERE ${CustID} = c.CustID
;

</stringProp>
