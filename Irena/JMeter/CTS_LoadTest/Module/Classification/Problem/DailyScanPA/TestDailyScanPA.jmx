        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert data tbl: Customer_InitialGroupBetting" enabled="true">
          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">insert into Customer_InitialGroupBetting (CustId,GBTicketCount,SportType,SourceCreatedDate,CreatedDate)
