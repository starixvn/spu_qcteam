          <stringProp name="query">INSERT INTO CTSCustomerClassification (CustID, CTSCustID, SubscriberID, ParentID, CategoryID, CreatedDate, CreatedBy, LastModifiedDate, LastModifiedBy, LastScannedDate, IsMarkedDirectly, IsFromTVS, IsFromCTS, IsFromTW, IsFromAI, IsFromImperva, IssueTypeID, TVSRequestID, SportType, IsParlay, Remark)
SELECT distinct ${CustID}
	,	c.CTSCustID
     ,	c.SubscriberID
     ,	${ParentID}
     ,	${CategoryID}
     ,	&apos;${CurrentDateTime}&apos;
     ,	${SystemID}
     ,	&apos;${CurrentDateTime}&apos;
     ,	${SystemID}
     ,	&apos;${CurrentDateTime}&apos;
     ,    ${IsMarkedDirectly}
     ,	${IsFromTVS}
     ,	${IsFromCTS}
     ,	${IsFromTW}
     ,	${IsFromAI}
     ,	${IsFromImperva}
     ,	${IssueTypeID}
     ,	${TVSRequestID}
     ,	${SportType}
     ,	${IsParlay}
     , 	&apos;${Remark}&apos;
FROM CTSCustomer AS c 
WHERE ${CustID} = c.CustID
;</stringProp>
