            <stringProp name="Argument.value">${ProjectFolder}/CustList.txt</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="Yesterday" elementType="Argument">
            <stringProp name="Argument.name">Yesterday</stringProp>
            <stringProp name="Argument.value">2024-08-17 01:00:00</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
