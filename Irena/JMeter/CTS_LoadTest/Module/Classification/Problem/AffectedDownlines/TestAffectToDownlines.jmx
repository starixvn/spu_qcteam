      <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Get CustID list" enabled="true">
        <stringProp name="scriptLanguage">groovy</stringProp>
        <stringProp name="parameters">CustIDList</stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="script">String readFileToString(String filePath) {
    String content = &apos;&apos;
    try {
        content = new File(filePath).text
    } catch (Exception e) {
        log.error(&quot;Error reading file: ${e.message}&quot;)
    }
    return content
}

def filePath = &apos;${CustListPath}&apos;
def CustList = readFileToString(filePath)
vars.put(&quot;CustList&quot;, CustList)</stringProp>
      </JSR223PreProcessor>
      <hashTree/>
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="[1. Clean data]" enabled="true">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <longProp name="ThreadGroup.duration">100</longProp>
        <longProp name="ThreadGroup.delay">0</longProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">false</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </SetupThreadGroup>
