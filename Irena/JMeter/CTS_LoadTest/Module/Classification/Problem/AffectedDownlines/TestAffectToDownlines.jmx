        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert data tbl: CTSCustomerClassification_History" enabled="true">
          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">INSERT INTO CTSCustomerClassification_History (CustID, CTSCustID, ParentID, CategoryID, LastModifiedDate, LastModifiedBy, InsertDate, IsMarkedDirectly, IsFromCTS, IsFromAI, IsFromTW, IsFromTVS, TVSRequestID, IssueTypeID, TurnoverRM, WinlossRM, BetCount, ActiveDays, Remark, SourceTypeID, TargetCC, OldCategoryID, DWCategoryID, IsDataChanged, ActionType)
SELECT distinct ${CustID}
	,	c.CTSCustID
     ,	${ParentID}
     ,	${CategoryID}
     ,	&apos;${CurrentDateTime}&apos;
     ,	${CreatedBy}
     ,	&apos;${CurrentDateTime}&apos;
     ,    ${IsMarkedDirectly}
     ,	${IsFromCTS}
     ,	${IsFromAI}
     ,	${IsFromTW}
     ,	${IsFromTVS}
     ,	${TVSRequestID}
     ,	${IssueTypeID}
     ,    case when ${CustID} IN (4183,58969,118211,31987,65063,118262) THEN null ELSE 10000 end 
     ,    case when ${CustID} IN (4183,58969,118211,31987,65063,118262) THEN null ELSE 1000 end
     ,    case when ${CustID} IN (4183,58969,118211,31987,65063,118262) THEN null ELSE 10 end
     ,    case when ${CustID} IN (4183,58969,118211,31987,65063,118262) THEN null ELSE 5 end
     , 	&apos;${Remark}&apos;
     ,    ${SourceTypeID}
     ,    ${TargetCC}
     ,    NULL
     ,    ${CategoryID}
     ,	1
     ,	0
FROM CTSCustomer AS c 
WHERE ${CustID} = c.CustID and c.CustSubID = 0 and ${CategoryID} NOT IN (10300, 10200, 10201)
;

</stringProp>
          <stringProp name="queryArguments"></stringProp>
