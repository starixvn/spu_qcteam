      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="ProjectFolder" elementType="Argument">
            <stringProp name="Argument.name">ProjectFolder</stringProp>
            <stringProp name="Argument.value">\\AffectedDownlines</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath">D:\CTS_LoadTest\DBDriver\mssql-jdbc-12.6.1.jre8.jar,D:\CTS_LoadTest\DBDriver\mysql-connector-j-8.3.0.jar</stringProp>
    </TestPlan>
    <hashTree>
      <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="[Var Config] Common">
        <collectionProp name="Arguments.arguments">
          <elementProp name="RowNum" elementType="Argument">
            <stringProp name="Argument.name">RowNum</stringProp>
            <stringProp name="Argument.value">100</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="LoopNum" elementType="Argument">
            <stringProp name="Argument.name">LoopNum</stringProp>
            <stringProp name="Argument.value">5</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="MySQL_Conn_Local" elementType="Argument">
            <stringProp name="Argument.value">jdbc:mysql://10.18.200.70:3307</stringProp>
            <stringProp name="Argument.name">MySQL_Conn_Local</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SQLServer_Conn_DBCUST" elementType="Argument">
            <stringProp name="Argument.name">SQLServer_Conn_DBCUST</stringProp>
            <stringProp name="Argument.value">jdbc:sqlserver://TESTDBCUST:1433;encrypt=true;trustServerCertificate=true</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SQLServer_Conn_DB053" elementType="Argument">
            <stringProp name="Argument.name">SQLServer_Conn_DB053</stringProp>
            <stringProp name="Argument.value">jdbc:sqlserver://TESTDB053:1433;encrypt=true;trustServerCertificate=true</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="CurrentDateTime" elementType="Argument">
            <stringProp name="Argument.name">CurrentDateTime</stringProp>
            <stringProp name="Argument.value">${__groovy( import java.text.SimpleDateFormat; import java.util.TimeZone; def dateFormat = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss&quot;); dateFormat.setTimeZone(TimeZone.getTimeZone(&quot;GMT-4&quot;)); return dateFormat.format(new Date()); )}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="Data" elementType="Argument">
            <stringProp name="Argument.name">Data</stringProp>
            <stringProp name="Argument.value">${ProjectFolder}/AffectDownlines.csv</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
