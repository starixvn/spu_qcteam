          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">INSERT INTO CustomerLoginInfoDetection (CTSCustID, CustID, FirstBetDate, Bot, InvalidBrowser, BotTransPercentage, InvalidBrowserInfoTransPercentage, SourceCreatedDate, InsertedTime)
SELECT 	c.CTSCustID
     ,	c.CustID
     ,	&apos;${Yesterday}&apos;
     ,	7
     ,	0
     ,	&apos;53.85&apos;
     ,	&apos;0.0&apos;
     ,	&apos;${Yesterday}&apos;
     ,	&apos;${Yesterday}&apos;
FROM CTSCustomer AS c 
WHERE ${CustID} = c.CustID and c.CustSubID = 0 and ${CategoryID} IN (21000, 26000)
;</stringProp>
