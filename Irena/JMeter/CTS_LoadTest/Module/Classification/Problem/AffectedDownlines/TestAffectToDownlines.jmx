          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">INSERT INTO Customer_DangerousScore (CustID, IsLicensee, DangerousScore, CreatedDate, LastModifiedDate, ClassifiedScore, ClassifiedDate) 
