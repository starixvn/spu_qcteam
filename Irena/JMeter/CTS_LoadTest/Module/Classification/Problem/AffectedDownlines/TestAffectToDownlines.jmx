          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">INSERT INTO CTSCustomerClassification_Log (CustID, CTSCustID, ParentID, CategoryID, LastModifiedDate, LastModifiedBy, InsertDate, IsMarkedDirectly, IsFromCTS, IsFromAI, IsFromTW, IsFromTVS, TVSRequestID, IssueTypeID, TurnoverRM, WinlossRM, BetCount, ActiveDays, Remark, SourceTypeID, TargetCC, OldCategoryID, DWCategoryID, IsDataChanged, ActionType)
