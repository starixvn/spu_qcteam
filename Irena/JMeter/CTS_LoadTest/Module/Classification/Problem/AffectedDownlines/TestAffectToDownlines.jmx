        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert data tbl: SpecialCustomerClass" enabled="true">
          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">INSERT INTO SpecialCustomerClass (CTSCustID, RootCTSCustID, CustID, SubscriberID, CustomerClass, CreatedDate, CreatedBy, CreatedFromFunction)
SELECT 	c.CTSCustID
	,	c.CTSCustID
	,	${CustID}
	,	c.SubscriberID
	,	${TargetCC}
	,	&apos;${CurrentDateTime}&apos;
	,	${CreatedBy}
	,	1
FROM CTSCustomer AS c 
WHERE ${CustID} = c.CustID and c.CustSubID = 0 and ${CategoryID} = 10300
;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
