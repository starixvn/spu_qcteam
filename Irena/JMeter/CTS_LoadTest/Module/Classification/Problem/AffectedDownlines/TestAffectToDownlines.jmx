          <stringProp name="dataSource">CTSDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">INSERT INTO CTSCustomerClassification (CustID, CTSCustID, SubscriberID, ParentID, CategoryID, CreatedDate, CreatedBy, LastModifiedDate, LastModifiedBy, LastScannedDate, IsMarkedDirectly, IsFromCTS, IsFromAI, IsFromTW, IsFromTVS, TVSRequestID, IssueTypeID, Remark, RoleID)
SELECT distinct ${CustID}
	,	c.CTSCustID
     ,	c.SubscriberID
     ,	${ParentID}
     ,	${CategoryID}
     ,	&apos;${CurrentDateTime}&apos;
     ,	${CreatedBy}
     ,	&apos;${CurrentDateTime}&apos;
     ,	${CreatedBy}
     ,	&apos;${CurrentDateTime}&apos;
     ,    ${IsMarkedDirectly}
     ,	${IsFromCTS}
     ,	${IsFromAI}
     ,	${IsFromTW}
     ,	${IsFromTVS}
     ,	${TVSRequestID}
     ,	${IssueTypeID}
     , 	&apos;${Remark}&apos;
     ,	c.RoleID
FROM CTSCustomer AS c 
WHERE ${CustID} = c.CustID and c.CustSubID = 0
;</stringProp>
