      <hashTree>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="Get New Match Info">
          <stringProp name="filename">${NewMatchInfoPath}</stringProp>
          <stringProp name="fileEncoding">utf-8</stringProp>
          <stringProp name="variableNames">No,Market,SportType,LeagueID,HomeID,AwayID,Range</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <stringProp name="delimiter">,</stringProp>
          <boolProp name="quotedData">false</boolProp>
          <boolProp name="recycle">false</boolProp>
          <boolProp name="stopThread">true</boolProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
        </CSVDataSet>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl dbo.match ">
          <stringProp name="dataSource">MatchDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert into dbo.match (leagueid,homeid,homeid2,awayid,awayid2,eventstatus,eventdate,kickofftime,GlobalShowTime,creator,matchcode,sporttype,DisplayMode,LeaguePatternID,HomeDisplayPatternID,AwayDisplayPatternID,IsNeutral,HasLive)
select 	${LeagueID}
	,	${HomeID}
	,	${HomeID}
	,	${AwayID}
	,	${AwayID}
	,	&apos;running&apos;
	,	CASE WHEN ${Range} = 0 THEN &apos;${Tomorrow}&apos;
			WHEN ${Range} = 1 THEN &apos;${Today}&apos; 
			WHEN ${Range} = 2 THEN &apos;${Yesterday}&apos; 
			WHEN ${Range} = 3 THEN &apos;${Last6d}&apos; 
			WHEN ${Range} = 4 THEN &apos;${Last7d}&apos; END
	,	CASE WHEN ${Range} = 0 THEN &apos;${Tomorrow}&apos;
			WHEN ${Range} = 1 THEN &apos;${Today}&apos; 
			WHEN ${Range} = 2 THEN &apos;${Yesterday}&apos; 
			WHEN ${Range} = 3 THEN &apos;${Last6d}&apos; 
			WHEN ${Range} = 4 THEN &apos;${Last7d}&apos; END
	,	CASE WHEN ${Range} = 0 THEN &apos;${Tomorrow}&apos;
			WHEN ${Range} = 1 THEN &apos;${Today}&apos; 
			WHEN ${Range} = 2 THEN &apos;${Yesterday}&apos; 
			WHEN ${Range} = 3 THEN &apos;${Last6d}&apos; 
			WHEN ${Range} = 4 THEN &apos;${Last7d}&apos; END
	,	8
	,	CONCAT(&apos;NAGA TEST MATCH &apos;, &apos;${Market}&apos;, &apos; &apos;, &apos;${No}&apos;) 
	,	${SportType}
	,	1
	,	1
	,	1
	,	1
	,	0
	,	1
;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
      </hashTree>
