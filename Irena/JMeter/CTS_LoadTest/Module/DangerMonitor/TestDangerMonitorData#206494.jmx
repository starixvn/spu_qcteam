        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl dbo.bettrans14" enabled="true">
          <stringProp name="dataSource">TransDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert into dbo.bettrans14 (transid,winlostdate,transdate,matchid,liveindicator,livehomescore,liveawayscore,statusid,status,bettype,betid,betteam,betfrom,oddstype,odds,hdp1,hdp2,stake,actualrate,custid,username,recommend,mrecommend,srecommend,currency,currencyName,oddsid,ip,refno,creator) 
select b.transid,b.winlostdate,b.transdate,b.matchid,b.liveindicator,b.livehomescore,b.liveawayscore,b.statusid,b.status,b.bettype,b.betid,b.betteam,b.betfrom,b.oddstype,b.odds,b.hdp1,b.hdp2,b.stake,b.actualrate,b.custid,b.username,b.recommend,b.mrecommend,b.srecommend,b.currency,b.currencyName,b.oddsid,b.ip,b.refno,8
from dbo.bettrans as b with(nolock)
	inner join dbo.match as m with(nolock) on m.matchid = b.matchid
where m.MatchCode like &apos;NAGA TEST MATCH%&apos; and m.eventdate in (&apos;${Last6d}&apos;, &apos;${Last7d}&apos;) and b.winlostdate in (&apos;${Last6d}&apos;, &apos;${Last7d}&apos;)
;</stringProp>
