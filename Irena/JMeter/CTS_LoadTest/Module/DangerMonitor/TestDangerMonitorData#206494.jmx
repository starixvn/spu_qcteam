        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Update CC &amp; Danger Info">
          <stringProp name="dataSource">CustDB</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">/*No danger: cust1,cust2,cust3,cust4,cust5,cust36,cust37,cust38,cust39,cust40*/
update custinfo 
set CustomerClass=${CustomerClass}, Danger3=${Danger3}, Danger2=${Danger2}, Danger=${Danger}, Danger4=${Danger4}, Danger5=${Danger5}
where CustID = ${CustID};</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
