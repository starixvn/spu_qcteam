      <hashTree>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="Get New Trans Info" enabled="true">
          <stringProp name="filename">${NewTransInfoPath}</stringProp>
          <stringProp name="fileEncoding">utf-8</stringProp>
          <stringProp name="variableNames">MatchNo,LiveIndicator,BetTypeID,BetID,BetTeam,CustID,UserName,Recommend,MRecommend,SRecommend,Currency,CurrencyName</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <stringProp name="delimiter">,</stringProp>
          <boolProp name="quotedData">false</boolProp>
          <boolProp name="recycle">false</boolProp>
          <boolProp name="stopThread">true</boolProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
        </CSVDataSet>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl dbo.bettrans" enabled="true">
          <stringProp name="dataSource">TransDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert into dbo.bettrans (winlostdate,transdate,matchid,liveindicator,livehomescore,liveawayscore,statusid,status,bettype,betid,betteam,betfrom,oddstype,odds,hdp1,hdp2,stake,actualrate,custid,username,recommend,mrecommend,srecommend,currency,currencyName,oddsid,ip,refno) 
select m.EventDate,m.EventDate,m.MatchID,${LiveIndicator},0,0,0,&apos;running&apos;,${BetTypeID},${BetID},&apos;${BetTeam}&apos;,&apos;i&apos;,2,&apos;0.1&apos;,&apos;0.5&apos;,&apos;0&apos;,500,1,${CustID},&apos;${UserName}&apos;,${Recommend},${MRecommend},${SRecommend},${Currency},&apos;${CurrencyName}&apos;,0,&apos;10.200.18.100&apos;,0
from dbo.match as m with(nolock)
where m.MatchCode like &apos;NAGA TEST MATCH%&apos; and RIGHT(m.MatchCode, 3) = &apos;${MatchNo}&apos;
;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="[5. Prepare  match &amp; trans last 14d]">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <longProp name="ThreadGroup.duration">60</longProp>
        <longProp name="ThreadGroup.delay">0</longProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">false</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert tbl dbo.match14" enabled="true">
          <stringProp name="dataSource">MatchDB</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">insert into dbo.match14 (matchid,leagueid,homeid,homeid2,awayid,awayid2,eventstatus,eventdate,kickofftime,GlobalShowTime,creator,matchcode,sporttype,DisplayMode,LeaguePatternID,HomeDisplayPatternID,AwayDisplayPatternID,IsNeutral)
select matchid,leagueid,homeid,homeid2,awayid,awayid2,&apos;completed&apos;,eventdate,kickofftime,GlobalShowTime,creator,matchcode,sporttype,DisplayMode,LeaguePatternID,HomeDisplayPatternID,AwayDisplayPatternID,IsNeutral
from dbo.match with(nolock)
where matchcode like &apos;NAGA TEST MATCH%&apos; and eventdate in (&apos;${Last6d}&apos;, &apos;${Last7d}&apos;) 
;</stringProp>
          <stringProp name="queryArguments"></stringProp>
