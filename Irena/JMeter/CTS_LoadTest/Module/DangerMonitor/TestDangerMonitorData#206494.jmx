          <elementProp name="CurrentDateTime" elementType="Argument">
            <stringProp name="Argument.name">CurrentDateTime</stringProp>
            <stringProp name="Argument.value">${__groovy(new Date().format(&quot;yyyy-MM-dd hh:mm:ss&quot;),)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="Tomorrow" elementType="Argument">
            <stringProp name="Argument.name">Tomorrow</stringProp>
            <stringProp name="Argument.value">${__groovy((new Date() + 1).format(&quot;yyyy-MM-dd&quot;),)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="Today" elementType="Argument">
            <stringProp name="Argument.name">Today</stringProp>
            <stringProp name="Argument.value">${__groovy(new Date().format(&quot;yyyy-MM-dd&quot;),)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="Yesterday" elementType="Argument">
            <stringProp name="Argument.name">Yesterday</stringProp>
            <stringProp name="Argument.value">${__groovy((new Date() - 1).format(&quot;yyyy-MM-dd&quot;),)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="Last6d" elementType="Argument">
            <stringProp name="Argument.name">Last6d</stringProp>
            <stringProp name="Argument.value">${__groovy((new Date() - 6).format(&quot;yyyy-MM-dd&quot;),)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="Last7d" elementType="Argument">
            <stringProp name="Argument.name">Last7d</stringProp>
            <stringProp name="Argument.value">${__groovy((new Date() - 7).format(&quot;yyyy-MM-dd&quot;),)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="Last8d" elementType="Argument">
            <stringProp name="Argument.name">Last8d</stringProp>
            <stringProp name="Argument.value">${__groovy((new Date() - 8).format(&quot;yyyy-MM-dd&quot;),)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </Arguments>
