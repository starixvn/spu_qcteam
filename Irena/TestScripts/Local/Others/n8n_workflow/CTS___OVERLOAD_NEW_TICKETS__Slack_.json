        "jsCode": "function formatDateGmt7(date) {\n    const gmt7 = new Date(date.getTime() + 7 * 60 * 60 * 1000);\n    const yyyy = gmt7.getFullYear();\n    const mm = String(gmt7.getMonth() + 1).padStart(2, '0');\n    const dd = String(gmt7.getDate()).padStart(2, '0');\n    const hh = String(gmt7.getHours()).padStart(2, '0');\n    const mi = String(gmt7.getMinutes()).padStart(2, '0');\n    const ss = String(gmt7.getSeconds()).padStart(2, '0');\n    return `${yyyy}-${mm}-${dd} ${hh}:${mi}:${ss}`;\n}\n\nconst scannedTime = formatDateGmt7(new Date());\nconst env = \"LOCAL\";\n\nlet message = `*🔥ALERT🔥 [OVERLOAD NEW TICKETS - Threshold=20000]*\\n`;\nmessage += `*▪️Environment*: ${env}\\n`;\nmessage += `*▪️Scanned Time (GMT+7)*: ${scannedTime}\\n`;\nmessage += `*▪️Total New Tickets (GMT-4)*:`;\n\nif (Array.isArray(items) && items.length > 0) {\n    for (let item of items) {\n        const row = item.json;\n        message += `\\n      ModifiedDate: ${row.ModifiedDate} | Total: ${row.Total}`;\n    }\n} else {\n    message += `\\n       No data found or unexpected format.`;\n}\n\nreturn [\n  {\n    json: {\n      message: message\n    }\n  }\n];"
      },
